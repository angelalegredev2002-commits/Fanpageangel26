---
import ThemeBtn from '../ui/buttons/ThemeBtn.astro';
import LanguagePicker from '../ui/LanguagePicker.astro';
import ThemeCustomizer from '../ui/ThemeCustomizer.astro';
import CommandPalette from '../ui/CommandPalette.astro';

const pathname = Astro.url.pathname;

// Build breadcrumb from path
const segments = pathname.replace(/^\/adminpanel\/?/, '').split('/').filter(Boolean);
const crumbMap: Record<string, string> = {
  landing: 'Landing Page',
  site: 'Site Content',
  legal: 'Legal',
  media: 'Media Library',
  users: 'Users',
  settings: 'Settings',
  hero: 'Hero Section',
  sections: 'Títulos de Secciones',
  faqs: 'FAQs',
  features: 'Características',
  testimonials: 'Testimonios',
  pricing: 'Precios',
  partners: 'Partners',
  header: 'Header',
  footer: 'Footer',
  cookies: 'Cookies Banner',
  privacy: 'Privacy Policy',
  terms: 'Terms & Conditions',
};
---

<header
  class="relative z-50 flex h-16 shrink-0 items-center justify-between border-b border-neutral-200 bg-white/80 px-4 sm:px-6 backdrop-blur-md transition-colors duration-300 dark:border-neutral-800 dark:bg-neutral-900/80"
>
  <!-- Mobile sidebar toggle + Breadcrumb -->
  <div class="flex items-center gap-4">
    <button
      class="sidebar-toggle text-neutral-600 hover:text-neutral-900 md:hidden dark:text-neutral-400 dark:hover:text-neutral-200"
    >
      <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"
        ><path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 6h16M4 12h16M4 18h16"></path></svg
      >
    </button>

    <!-- Breadcrumb -->
    <nav class="hidden items-center gap-2 text-sm lg:flex" aria-label="breadcrumb">
      <a
        href="/adminpanel"
        class="flex items-center gap-1.5 font-medium text-neutral-500 transition-colors hover:text-orange-500 dark:text-neutral-400 dark:hover:text-orange-400"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"
          ></path>
        </svg>
        Dashboard
      </a>
      {
        segments.map((seg, i) => (
          <>
            <svg
              class="h-3.5 w-3.5 text-neutral-400"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M9 5l7 7-7 7"
              />
            </svg>
            {i === segments.length - 1 ? (
              <span class="font-semibold text-neutral-900 dark:text-white">
                {crumbMap[seg] ?? seg}
              </span>
            ) : (
              <span class="text-neutral-500 dark:text-neutral-400">
                {crumbMap[seg] ?? seg}
              </span>
            )}
          </>
        ))
      }
    </nav>
  </div>

  <!-- Center/Right Search + Controls -->
  <div class="flex items-center gap-2 sm:gap-3">
    <!-- Command Palette / Search -->
    <CommandPalette />

    <!-- Language Picker -->
    <LanguagePicker />

    <!-- Theme Customizer (Palette icon dropdown) -->
    <ThemeCustomizer />

    <!-- Theme Toggle (Light/Dark Icon) -->
    <ThemeBtn />

    <!-- Notifications -->
    <div class="relative hidden sm:block">
      <span class="absolute top-0 right-0 h-2 w-2 animate-pulse rounded-full bg-orange-500"></span>
      <button
        class="flex h-9 w-9 items-center justify-center rounded-xl text-neutral-600 transition-all hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-neutral-200"
        aria-label="Notifications"
      >
        <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"
          ></path>
        </svg>
      </button>
    </div>

    <!-- User Avatar + Dropdown -->
    <div class="group relative">
      <button
        class="flex h-9 w-9 cursor-pointer items-center justify-center rounded-full bg-gradient-to-tr from-orange-400 to-orange-600 text-sm font-bold text-white shadow-lg shadow-orange-500/20 transition-transform hover:scale-105"
      >
        AA
      </button>

      <!-- Dropdown -->
      <div
        class="invisible absolute right-0 z-[100] mt-2 w-64 origin-top-right transform rounded-xl border border-neutral-200 bg-white opacity-0 shadow-2xl transition-all group-hover:visible group-hover:opacity-100 dark:border-neutral-800 dark:bg-neutral-900"
      >
        <div class="rounded-t-xl border-b border-neutral-100 bg-neutral-50 p-4 dark:border-neutral-800 dark:bg-neutral-800/30">
          <p class="text-sm font-bold text-neutral-900 dark:text-white">Angel Alegre</p>
          <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">Administrador Principal</p>
          <div class="mt-2 flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-green-500"></span>
            <span class="text-[10px] font-bold tracking-wider text-green-500 uppercase">En línea</span>
          </div>
        </div>

        <div class="space-y-1 border-b border-neutral-100 p-2 dark:border-neutral-800">
          <a
            href="#"
            class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-neutral-700 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white"
          >
            <svg class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            Mi Perfil
          </a>
          <a
            href="/adminpanel/settings"
            class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-neutral-700 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white"
          >
            <svg class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Ajustes de Cuenta
          </a>
        </div>

        <div class="space-y-1 border-b border-neutral-100 p-2 dark:border-neutral-800">
          <a
            href="/"
            target="_blank"
            class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm text-neutral-700 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white"
          >
            <svg class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            Ver Sitio Público
          </a>
        </div>

        <div class="p-2">
          <a
            href="/logout"
            class="flex items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium text-red-500 transition-colors hover:bg-red-50 hover:text-red-600 dark:text-red-400 dark:hover:bg-red-500/10 dark:hover:text-red-300"
          >
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" />
            </svg>
            Cerrar Sesión Segura
          </a>
        </div>
      </div>
    </div>
  </div>

  <script type="module">
    import { initSidebar } from '../../utils/adminStore.ts';
    initSidebar();
  </script>
</header>
