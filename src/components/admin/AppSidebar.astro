---
const pathname = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === '/adminpanel') return pathname === '/adminpanel' || pathname === '/adminpanel/';
  return pathname.startsWith(href);
}

function linkClass(href: string, size: 'normal' | 'small' = 'normal'): string {
  const base = 'group flex items-center gap-2.5 rounded-lg px-3 transition-all duration-150 text-xs';
  const py = size === 'small' ? 'py-1.5' : 'py-2';
  if (isActive(href)) {
    return `${base} ${py} bg-orange-500/10 text-orange-500 border-l-2 border-orange-500 pl-[10px] font-medium dark:text-orange-400`;
  }
  return `${base} ${py} text-neutral-600 hover:bg-neutral-100 hover:text-neutral-900 font-normal dark:text-neutral-400 dark:hover:bg-neutral-800/70 dark:hover:text-neutral-200`;
}

function iconClass(href: string): string {
  if (isActive(href)) {
    return 'h-4 w-4 text-orange-500 dark:text-orange-400';
  }
  return 'h-4 w-4 text-neutral-400 transition-colors group-hover:text-neutral-700 dark:text-neutral-500 dark:group-hover:text-neutral-300';
}
