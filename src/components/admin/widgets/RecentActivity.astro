---
const recentActivity = [
  {
    user: 'Carlos Mendoza',
    initials: 'CM',
    color: 'from-blue-500 to-blue-600',
    action: 'Nueva consulta enviada',
    detail: 'Preguntó sobre el plan "Ecosystem"',
    time: 'Hace 5 min',
    type: 'message',
  },
  {
    user: 'Angel Alegre',
    initials: 'AA',
    color: 'from-orange-500 to-orange-600',
    action: 'Actualizó sección "Precios"',
    detail: 'Plan Starter ajustado a nuevos términos',
    time: 'Hace 1 hora',
    type: 'edit',
  },
  {
    user: 'Angel Alegre',
    initials: 'AA',
    color: 'from-orange-500 to-orange-600',
    action: 'Nueva imagen en Media Library',
    detail: 'hero-banner-2026.webp',
    time: 'Hace 3 horas',
    type: 'media',
  },
  {
    user: 'Laura González',
    initials: 'LG',
    color: 'from-purple-500 to-purple-600',
    action: 'Consulta sobre planes corporativos',
    detail: 'Solicita información adicional para equipo',
    time: 'Ayer, 18:42',
    type: 'message',
  },
  {
    user: 'Sistema',
    initials: 'SY',
    color: 'from-emerald-500 to-emerald-600',
    action: 'Despliegue exitoso en producción',
    detail: 'Build v2.4.1 completado en Vercel',
    time: 'Ayer, 10:15',
    type: 'deploy',
  },
];

const typeIcons: Record<string, string> = {
  message: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>`,
  edit: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>`,
  media: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>`,
  deploy: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 13l4 4L19 7"/>`,
};

const typeBg: Record<string, string> = {
  message: 'bg-blue-500/10 text-blue-500 dark:text-blue-400',
  edit: 'bg-orange-500/10 text-orange-500 dark:text-orange-400',
  media: 'bg-purple-500/10 text-purple-500 dark:text-purple-400',
  deploy: 'bg-emerald-500/10 text-emerald-500 dark:text-emerald-400',
};
---

<div
  class="rounded-xl border border-neutral-200/80 bg-white p-5 shadow-xs transition-colors duration-200 dark:border-neutral-800/80 dark:bg-neutral-900/60"
>
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">Actividad Reciente</h2>
    <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-[11px] font-medium text-neutral-600 dark:bg-neutral-800 dark:text-neutral-300">
      {recentActivity.length} eventos
    </span>
  </div>

  <div class="space-y-3.5">
    {
      recentActivity.map((activity, index) => (
        <>
          <div class="flex items-start gap-3">
            <!-- Avatar -->
            <div
              class={`flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gradient-to-br ${activity.color} text-[11px] font-semibold text-white shadow-xs`}
            >
              {activity.initials}
            </div>

            <!-- Content -->
            <div class="min-w-0 flex-1">
              <div class="flex items-start justify-between gap-2">
                <div class="min-w-0">
                  <p class="truncate text-xs font-medium text-neutral-900 dark:text-neutral-100">
                    {activity.action}
                  </p>
                  <p class="truncate text-[11px] text-neutral-500 dark:text-neutral-400">
                    {activity.detail}
                  </p>
                </div>
                <!-- Type icon -->
                <div class={`shrink-0 rounded-md p-1 ${typeBg[activity.type]}`}>
                  <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={typeIcons[activity.type]} />
                </div>
              </div>
              <div class="mt-0.5 flex items-center gap-1.5 text-[10px] text-neutral-400 dark:text-neutral-500">
                <span>{activity.user}</span>
                <span>·</span>
                <span>{activity.time}</span>
              </div>
            </div>
          </div>

          {index < recentActivity.length - 1 && (
            <div class="ml-11 border-t border-dashed border-neutral-100 dark:border-neutral-800/60" />
          )}
        </>
      ))
    }
  </div>

  <a
    href="/adminpanel/users"
    class="mt-4 block rounded-lg border border-neutral-200 py-2 text-center text-xs font-medium text-neutral-600 transition-all hover:bg-neutral-50 dark:border-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-800/60 dark:hover:text-neutral-200"
  >
    Ver Toda la Actividad →
  </a>
</div>
