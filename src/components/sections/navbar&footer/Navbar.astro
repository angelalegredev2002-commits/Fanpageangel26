---
// Import relevant dependencies
import ThemeIcon from '@components/ThemeIcon.astro';
import NavLink from '@components/ui/links/NavLink.astro';
import Authentication from '../misc/Authentication.astro';
import enStrings from '@utils/navigation.ts';
import esStrings from '@utils/es/navigation.ts';
import BrandLogo from '@components/BrandLogo.astro';
import LanguagePicker from '@components/ui/LanguagePicker.astro';
import ThemeCustomizer from '@components/ui/ThemeCustomizer.astro';
import CommandPalette from '@components/ui/CommandPalette.astro';
import { getDB } from '../../../utils/db';

const db = getDB();
const brandText = db.site?.brandText || 'Angel Alegre';

// Select the correct translation based on the page's lang prop:
const strings = Astro.currentLocale === 'es' ? esStrings : enStrings;
const homeUrl = Astro.currentLocale === 'es' ? '/es' : '/';
---

{/* Main header component */}
<header
  class="relative z-50 mt-4 flex w-full flex-wrap text-sm md:flex-nowrap md:justify-start"
>
  {/* Navigation container */}
  <nav
    class="relative mx-2 w-full rounded-2xl border border-neutral-200/80 bg-white/80 px-4 py-2.5 shadow-xs backdrop-blur-md transition-colors duration-300 md:flex md:items-center md:justify-between md:px-6 md:py-2 dark:border-neutral-800 dark:bg-neutral-900/80 dark:text-neutral-200"
    aria-label="Global"
  >
    <div class="flex items-center justify-between">
      {/* Brand logo */}
      <a
        class="flex items-center rounded-lg py-1 text-lg font-bold tracking-tight outline-none focus-visible:ring-2 focus-visible:ring-orange-500"
        href={homeUrl}
        aria-label="Brand"
      >
        <span class="admin-brand-text bg-gradient-to-r from-orange-400 to-orange-600 bg-clip-text font-bold text-transparent">
          {brandText}
        </span>
      </a>

      {/* Collapse toggle for mobile */}
      <div class="mr-1 ml-auto flex items-center gap-1.5 md:hidden">
        <ThemeCustomizer />
        <button
          type="button"
          class="hs-collapse-toggle flex h-8 w-8 items-center justify-center rounded-lg text-neutral-600 transition hover:bg-neutral-100 dark:text-neutral-400 dark:hover:bg-neutral-800"
          data-hs-collapse="#navbar-collapse-with-animation"
          aria-controls="navbar-collapse-with-animation"
          aria-label="Toggle navigation"
        >
          <svg
            class="hs-collapse-open:hidden h-5 w-5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg
            class="hs-collapse-open:block hidden h-5 w-5 shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    </div>

    {/* Navigation links & Actions */}
    <div
      id="navbar-collapse-with-animation"
      class="hs-collapse hidden grow basis-full overflow-hidden transition-all duration-300 md:block"
    >
      <div
        class="mt-4 flex flex-col gap-2 md:mt-0 md:flex-row md:items-center md:justify-end md:gap-3 lg:gap-4"
      >
        {/* Navigation links */}
        <div class="flex flex-col gap-1 md:flex-row md:items-center md:gap-1">
          {
            strings.navBarLinks.map(link => (
              <NavLink url={link.url} name={link.name} />
            ))
          }
        </div>

        {/* Action Controls Group */}
        <div class="flex items-center gap-2 border-t border-neutral-100 pt-3 md:border-t-0 md:border-l md:border-neutral-200 md:pt-0 md:pl-3 dark:border-neutral-800">
          <CommandPalette />
          <LanguagePicker />
          <ThemeCustomizer />
          <Authentication />
        </div>
      </div>
    </div>
  </nav>
</header>
