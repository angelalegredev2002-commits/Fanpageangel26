---
// CommandPalette.astro - Quick search & command palette (Cmd+K / Ctrl+K)
---

<div class="relative hidden sm:block">
  <button
    id="cmd-palette-trigger"
    type="button"
    class="flex h-9 w-44 items-center justify-between rounded-xl border border-neutral-200 bg-neutral-50/80 px-3 text-xs text-neutral-400 shadow-sm transition-all hover:border-neutral-300 hover:bg-neutral-100 hover:text-neutral-600 md:w-60 dark:border-neutral-800 dark:bg-neutral-900/80 dark:hover:border-neutral-700 dark:hover:text-neutral-300"
  >
    <span class="flex items-center gap-2">
      <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <span>Type to search...</span>
    </span>
    <kbd class="rounded border border-neutral-200 bg-white px-1.5 py-0.5 text-[10px] font-semibold text-neutral-500 shadow-xs dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-400">
      ⌘K
    </kbd>
  </button>

  <!-- Modal backdrop & dialog -->
  <div
    id="cmd-modal"
    class="invisible fixed inset-0 z-[150] flex items-start justify-center bg-black/50 p-4 pt-20 opacity-0 backdrop-blur-xs transition-all duration-150"
  >
    <div
      id="cmd-dialog"
      class="w-full max-w-lg rounded-2xl border border-neutral-200 bg-white shadow-2xl transition-all duration-200 dark:border-neutral-800 dark:bg-neutral-900"
    >
      <!-- Search Input -->
      <div class="flex items-center border-b border-neutral-100 px-4 py-3.5 dark:border-neutral-800">
        <svg class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
        <input
          id="cmd-search-input"
          type="text"
          placeholder="Buscar páginas, secciones, configuraciones..."
          class="w-full bg-transparent px-3 text-sm text-neutral-900 placeholder:text-neutral-400 focus:outline-none dark:text-white"
        />
        <kbd class="rounded border border-neutral-200 bg-neutral-100 px-1.5 py-0.5 text-[10px] font-semibold text-neutral-500 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-400">
          ESC
        </kbd>
      </div>

      <!-- Search Results / Shortcuts -->
      <div class="max-h-72 overflow-y-auto p-2" id="cmd-results">
        <div class="px-3 py-1.5 text-[10px] font-bold tracking-wider text-neutral-400 uppercase">
          Páginas & Editores
        </div>
        <a href="/adminpanel" class="cmd-item flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium text-neutral-700 hover:bg-orange-50 hover:text-orange-600 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white">
          <span class="flex items-center gap-2.5">
            <svg class="h-4 w-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/></svg>
            Dashboard
          </span>
          <span class="text-[10px] text-neutral-400">/adminpanel</span>
        </a>
        <a href="/adminpanel/landing/hero" class="cmd-item flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium text-neutral-700 hover:bg-orange-50 hover:text-orange-600 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white">
          <span class="flex items-center gap-2.5">
            <svg class="h-4 w-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Hero Section Editor
          </span>
          <span class="text-[10px] text-neutral-400">Landing</span>
        </a>
        <a href="/adminpanel/landing/pricing" class="cmd-item flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium text-neutral-700 hover:bg-orange-50 hover:text-orange-600 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white">
          <span class="flex items-center gap-2.5">
            <svg class="h-4 w-4 text-orange-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Planes y Precios
          </span>
          <span class="text-[10px] text-neutral-400">Landing</span>
        </a>
        <a href="/adminpanel/users" class="cmd-item flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium text-neutral-700 hover:bg-orange-50 hover:text-orange-600 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white">
          <span class="flex items-center gap-2.5">
            <svg class="h-4 w-4 text-purple-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
            Usuarios
          </span>
          <span class="text-[10px] text-neutral-400">Admin</span>
        </a>
        <a href="/adminpanel/settings" class="cmd-item flex items-center justify-between rounded-xl px-3 py-2 text-xs font-medium text-neutral-700 hover:bg-orange-50 hover:text-orange-600 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white">
          <span class="flex items-center gap-2.5">
            <svg class="h-4 w-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            Configuración & SEO
          </span>
          <span class="text-[10px] text-neutral-400">Settings</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const trigger = document.getElementById('cmd-palette-trigger');
    const modal = document.getElementById('cmd-modal');
    const dialog = document.getElementById('cmd-dialog');
    const input = document.getElementById('cmd-search-input') as HTMLInputElement;

    function openModal() {
      modal?.classList.remove('invisible', 'opacity-0');
      modal?.classList.add('opacity-100');
      input?.focus();
    }

    function closeModal() {
      modal?.classList.add('invisible', 'opacity-0');
      modal?.classList.remove('opacity-100');
      if (input) input.value = '';
      filterItems('');
    }

    trigger?.addEventListener('click', openModal);

    modal?.addEventListener('click', (e) => {
      if (dialog && !dialog.contains(e.target as Node)) {
        closeModal();
      }
    });

    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        const isOpen = modal?.classList.contains('opacity-100');
        if (isOpen) closeModal();
        else openModal();
      }
      if (e.key === 'Escape') {
        closeModal();
      }
    });

    function filterItems(query: string) {
      const q = query.toLowerCase().trim();
      const items = document.querySelectorAll<HTMLElement>('.cmd-item');
      items.forEach(item => {
        const text = item.textContent?.toLowerCase() || '';
        item.style.display = text.includes(q) ? 'flex' : 'none';
      });
    }

    input?.addEventListener('input', (e) => {
      filterItems((e.target as HTMLInputElement).value);
    });
  })();
</script>
