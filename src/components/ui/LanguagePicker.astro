---
import { languages } from '@utils/ui';
const currentLocale = Astro.currentLocale || 'es';
const currentLabel = (languages as Record<string, string>)[currentLocale] || 'ES';
---

<div class="hs-dropdown relative inline-flex">
  <button
    id="hs-dropdown-lang-picker"
    type="button"
    aria-label="Change language"
    title="Change language"
    class="hs-dropdown-toggle inline-flex h-9 items-center gap-1.5 rounded-xl border border-neutral-200 bg-white px-2.5 text-xs font-semibold text-neutral-700 shadow-xs transition-colors hover:bg-neutral-100 hover:text-neutral-900 focus:outline-none dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300 dark:hover:bg-neutral-800 dark:hover:text-white"
  >
    <svg class="h-3.5 w-3.5 text-neutral-500 dark:text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
    </svg>
    <span class="uppercase">{currentLocale}</span>
    <svg
      class="hs-dropdown-open:rotate-180 h-3 w-3 text-neutral-400 transition-transform duration-200"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m6 9 6 6 6-6"></path>
    </svg>
  </button>

  <div
    class="hs-dropdown-menu duration hs-dropdown-open:opacity-100 right-0 top-full mt-2 hidden min-w-[130px] overflow-hidden rounded-xl border border-neutral-200 bg-white p-1 opacity-0 shadow-xl transition-[opacity,margin] dark:border-neutral-800 dark:bg-neutral-900 z-[120]"
    aria-labelledby="hs-dropdown-lang-picker"
  >
    {
      Object.entries(languages).map(([lang, label]) => {
        const isSelected = lang === currentLocale;
        return (
          <a
            class={`flex items-center justify-between rounded-lg px-2.5 py-1.5 text-xs font-medium transition-colors ${
              isSelected
                ? 'bg-orange-500/10 text-orange-600 font-semibold dark:text-orange-400'
                : 'text-neutral-700 hover:bg-neutral-100 dark:text-neutral-300 dark:hover:bg-neutral-800'
            }`}
            href={`/${lang === 'en' ? '' : lang}`}
            data-lang-target={lang}
          >
            <span>{label}</span>
            {isSelected && (
              <svg class="h-3.5 w-3.5 text-orange-500 dark:text-orange-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
              </svg>
            )}
          </a>
        );
      })
    }
  </div>
</div>

<script>
  type TLanguage = 'en' | 'es' | 'de' | 'fr' | 'fa' | 'ja' | 'zh-cn';
  const supportedLangs: TLanguage[] = ['en', 'es', 'de', 'fr', 'fa', 'ja', 'zh-cn'];

  document.addEventListener('DOMContentLoaded', function () {
    const languageLinks = document.querySelectorAll(
      "[aria-labelledby='hs-dropdown-lang-picker'] a[data-lang-target]"
    );

    languageLinks.forEach(element => {
      const link = element as HTMLAnchorElement;
      const targetLang = link.getAttribute('data-lang-target') as TLanguage;

      link.addEventListener('click', function (event) {
        event.preventDefault();

        const url = new URL(window.location.href);
        const currentPath = url.pathname
          .split('/')
          .filter(part => part && !supportedLangs.includes(part as TLanguage))
          .join('/');

        let newPath = '';
        if (targetLang && targetLang !== 'en') {
          newPath = `/${targetLang}/${currentPath}`;
        } else {
          newPath = `/${currentPath}`;
        }

        newPath = newPath.replace(/\/+/g, '/');
        if (newPath === '') newPath = '/';

        window.location.href = `${url.origin}${newPath}${url.search}`;
      });
    });
  });
</script>
