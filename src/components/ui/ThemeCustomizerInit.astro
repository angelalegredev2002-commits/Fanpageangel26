---
// ThemeCustomizerInit.astro - Fast inline initialization & global CSS variable engine
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Manrope:wght@400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&family=Roboto:wght@400;500;700&display=swap"
  rel="stylesheet"
/>

<script is:inline>
  (function () {
    try {
      const saved = localStorage.getItem('theme_customizer_settings');
      const settings = saved ? JSON.parse(saved) : {};

      // 1. Color Mode (Light / Dark / System)
      const colorMode = settings.colorMode || localStorage.getItem('hs_theme') || 'system';
      const isDark =
        colorMode === 'dark' ||
        (colorMode === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.classList.toggle('dark', isDark);

      // 2. Theme Preset (Accent colors)
      const preset = settings.preset || 'claude';
      document.documentElement.setAttribute('data-theme-preset', preset);

      // 3. Font
      const font = settings.font || 'manrope';
      document.documentElement.setAttribute('data-theme-font', font);

      // 4. Radius
      const radius = settings.radius || 'md';
      document.documentElement.setAttribute('data-theme-radius', radius);

      // 5. Content Layout
      const layout = settings.layout || 'full';
      document.documentElement.setAttribute('data-content-layout', layout);

      // 6. Scale
      const scale = settings.scale || 'md';
      document.documentElement.setAttribute('data-theme-scale', scale);

      // 7. Sidebar Variant & Mode
      const sidebarVariant = settings.sidebarVariant || 'flush';
      document.documentElement.setAttribute('data-sidebar-variant', sidebarVariant);

      const sidebarMode = settings.sidebarMode || 'expanded';
      document.documentElement.setAttribute('data-sidebar-mode', sidebarMode);
    } catch (e) {
      console.warn('Theme Customizer Init error:', e);
    }
  })();
</script>

<style is:global>
  /* ==========================================================================
     Theme Customizer Global Dynamic Variables & Rules
     ========================================================================== */

  /* 1. Font Families */
  html[data-theme-font='manrope'],
  html[data-theme-font='manrope'] body {
    font-family: 'Manrope', system-ui, -apple-system, sans-serif !important;
  }
  html[data-theme-font='inter'],
  html[data-theme-font='inter'] body {
    font-family: 'Inter', system-ui, -apple-system, sans-serif !important;
  }
  html[data-theme-font='outfit'],
  html[data-theme-font='outfit'] body {
    font-family: 'Outfit', system-ui, -apple-system, sans-serif !important;
  }
  html[data-theme-font='roboto'],
  html[data-theme-font='roboto'] body {
    font-family: 'Roboto', system-ui, -apple-system, sans-serif !important;
  }
  html[data-theme-font='system'],
  html[data-theme-font='system'] body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif !important;
  }

  /* 2. Radius scale */
  html[data-theme-radius='none'] * {
    border-radius: 0px !important;
  }
  html[data-theme-radius='sm'] {
    --app-radius: 0.375rem;
  }
  html[data-theme-radius='md'] {
    --app-radius: 0.75rem;
  }
  html[data-theme-radius='lg'] {
    --app-radius: 1.25rem;
  }

  /* 3. Scale factor */
  html[data-theme-scale='sm'] {
    font-size: 92%;
  }
  html[data-theme-scale='md'] {
    font-size: 100%;
  }
  html[data-theme-scale='lg'] {
    font-size: 108%;
  }

  /* 4. Content Layout */
  html[data-content-layout='compact'] .max-w-7xl {
    max-width: 64rem !important;
  }

  /* ==========================================================================
     5. Theme Presets - Dynamic Color Overrides for BOTH Sidebar and Layout
     ========================================================================== */

  /* CLAUDE (Terracotta / Warm Amber) */
  html[data-theme-preset='claude'] {
    --theme-primary: #c25e36;
    --theme-primary-rgb: 194, 94, 54;
    --theme-gradient-from: #d97706;
    --theme-gradient-to: #c2410c;
  }
  /* DEFAULT ORANGE */
  html[data-theme-preset='orange'] {
    --theme-primary: #f97316;
    --theme-primary-rgb: 249, 115, 22;
    --theme-gradient-from: #fb923c;
    --theme-gradient-to: #ea580c;
  }
  /* EMERALD GREEN */
  html[data-theme-preset='emerald'] {
    --theme-primary: #10b981;
    --theme-primary-rgb: 16, 185, 129;
    --theme-gradient-from: #34d399;
    --theme-gradient-to: #059669;
  }
  /* INDIGO / VIOLET */
  html[data-theme-preset='indigo'] {
    --theme-primary: #6366f1;
    --theme-primary-rgb: 99, 102, 241;
    --theme-gradient-from: #818cf8;
    --theme-gradient-to: #4f46e5;
  }
  /* OCEAN CYAN */
  html[data-theme-preset='cyan'] {
    --theme-primary: #06b6d4;
    --theme-primary-rgb: 6, 182, 212;
    --theme-gradient-from: #22d3ee;
    --theme-gradient-to: #0891b2;
  }
  /* ROSE PINK */
  html[data-theme-preset='rose'] {
    --theme-primary: #f43f5e;
    --theme-primary-rgb: 244, 63, 94;
    --theme-gradient-from: #fb7185;
    --theme-gradient-to: #e11d48;
  }
  /* MONOCHROME SLATE */
  html[data-theme-preset='monochrome'] {
    --theme-primary: #71717a;
    --theme-primary-rgb: 113, 113, 122;
    --theme-gradient-from: #a1a1aa;
    --theme-gradient-to: #52525b;
  }

  /* Universal Preset Style Bindings for Sidebar & Layout */
  html[data-theme-preset] #app-sidebar .bg-orange-500\/10,
  html[data-theme-preset] .bg-orange-500\/10 {
    background-color: rgba(var(--theme-primary-rgb), 0.12) !important;
  }
  html[data-theme-preset] #app-sidebar .border-orange-500,
  html[data-theme-preset] .border-orange-500 {
    border-color: var(--theme-primary) !important;
  }
  html[data-theme-preset] #app-sidebar .text-orange-500,
  html[data-theme-preset] #app-sidebar .text-orange-400,
  html[data-theme-preset] .text-orange-500,
  html[data-theme-preset] .text-orange-400 {
    color: var(--theme-primary) !important;
  }
  html[data-theme-preset] .bg-orange-500 {
    background-color: var(--theme-primary) !important;
  }
  html[data-theme-preset] .from-orange-400,
  html[data-theme-preset] .from-orange-500 {
    --tw-gradient-from: var(--theme-gradient-from) !important;
  }
  html[data-theme-preset] .to-orange-600 {
    --tw-gradient-to: var(--theme-gradient-to) !important;
  }
  html[data-theme-preset] .bg-orange-500\/5 {
    background-color: rgba(var(--theme-primary-rgb), 0.08) !important;
  }
  html[data-theme-preset] .admin-bar {
    background: linear-gradient(to top, var(--theme-gradient-to), var(--theme-gradient-from)) !important;
  }

  /* 6. Sidebar Variants in Admin */
  html[data-sidebar-variant='inset'] #app-sidebar {
    margin: 0.75rem;
    border-radius: 1rem;
    height: calc(100vh - 1.5rem);
    border: 1px solid rgba(120, 120, 120, 0.2);
  }
  html[data-sidebar-variant='floating'] #app-sidebar {
    margin: 1rem;
    border-radius: 1.25rem;
    height: calc(100vh - 2rem);
    box-shadow: 0 20px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1);
    border: 1px solid rgba(120, 120, 120, 0.15);
  }

  /* 7. Sidebar Modes in Admin */
  html[data-sidebar-mode='hidden'] #app-sidebar {
    display: none !important;
  }
  html[data-sidebar-mode='icon'] #app-sidebar {
    width: 4.5rem !important;
  }
  html[data-sidebar-mode='icon'] #app-sidebar span,
  html[data-sidebar-mode='icon'] #app-sidebar p,
  html[data-sidebar-mode='icon'] #app-sidebar h3 {
    display: none !important;
  }
  html[data-sidebar-mode='icon'] #app-sidebar a {
    justify-content: center !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }
</style>
