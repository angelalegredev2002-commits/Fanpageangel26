---
import Icon from '@components/ui/icons/Icon.astro';
import enStrings from '@utils/navigation.ts';
import esStrings from '@utils/es/navigation.ts';
import supportImage from '@images/starlight/suportchat.jpg';
import { Image } from 'astro:assets';

const strings = Astro.currentLocale === 'es' ? esStrings : enStrings;

const hubTitle = Astro.currentLocale === 'es' ? 'Hablemos' : "Let's Talk";
const hubSubTitle =
  Astro.currentLocale === 'es'
    ? '¿Cómo prefieres contactarme?'
    : 'How do you prefer to reach out?';

const whatsappMsg = encodeURIComponent(
  'Hola Angel, vengo de tu Fanpage y me interesa saber más sobre tus servicios.'
);
const whatsappURL = `https://wa.me/51900661201?text=${whatsappMsg}`;
---

<!-- Contact Hub Button -->
<div class="fixed right-6 bottom-6 z-50">
  <div class="hs-dropdown relative inline-flex">
    <button
      id="hs-dropdown-contact-hub"
      type="button"
      class="hs-dropdown-toggle group relative inline-flex h-14 w-14 items-center justify-center overflow-hidden rounded-full border-2 border-white/80 bg-gradient-to-br from-orange-400 via-orange-500 to-orange-600 text-white shadow-xl transition-all duration-300 hover:scale-105 focus:outline-none dark:border-neutral-800"
      aria-haspopup="menu"
      aria-expanded="false"
      aria-label="Contact options"
    >
      <!-- Support Photo -->
      <Image
        src={supportImage}
        alt="Support"
        class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-110"
      />

      <!-- Overlay hint -->
      <div
        class="absolute inset-0 bg-orange-500/10 transition-colors duration-300 group-hover:bg-transparent"
      >
      </div>

      <!-- Pulsing Online Dot -->
      <span class="absolute top-0.5 right-0.5 z-20 flex h-3.5 w-3.5">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-emerald-400 opacity-75"
        ></span>
        <span
          class="relative inline-flex h-3.5 w-3.5 rounded-full border-2 border-white bg-emerald-500"
        ></span>
      </span>
    </button>

    <!-- Compact Dropdown Menu -->
    <div
      class="hs-dropdown-menu duration hs-dropdown-open:opacity-100 right-0 bottom-full mb-3 hidden min-w-72 overflow-hidden rounded-2xl border border-neutral-200 bg-white p-0 opacity-0 shadow-2xl transition-[opacity,margin] dark:border-neutral-800 dark:bg-neutral-900"
      role="menu"
      aria-orientation="vertical"
      aria-labelledby="hs-dropdown-contact-hub"
    >
      <!-- Sleek Header -->
      <div
        class="admin-brand-icon relative flex items-center gap-x-3 overflow-hidden bg-gradient-to-r from-orange-500 to-orange-600 p-4"
      >
        <div
          class="relative z-10 size-11 shrink-0 rounded-full border-2 border-white/40 bg-white/10 p-0.5 backdrop-blur-xs"
        >
          <Image
            src={supportImage}
            alt="Sofía"
            class="size-full rounded-full object-cover"
          />
        </div>

        <div class="relative z-10 flex flex-col text-left">
          <h3 class="text-sm font-bold text-white">Sofía</h3>
          <p class="text-[10px] font-medium tracking-wider text-orange-100 uppercase">
            {hubTitle}
          </p>
          <div class="mt-0.5 flex items-center gap-x-1">
            <span class="size-1.5 animate-pulse rounded-full bg-emerald-400"></span>
            <span class="text-[10px] text-emerald-100">En línea ahora</span>
          </div>
        </div>
      </div>

      <!-- Action Options -->
      <div class="space-y-2 p-3">
        <p class="px-1 text-[11px] font-medium text-neutral-500 dark:text-neutral-400">
          {hubSubTitle}
        </p>

        <!-- WhatsApp Option -->
        <a
          href={whatsappURL}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-x-3 rounded-xl border border-emerald-500/20 bg-emerald-50/70 p-2.5 text-xs font-medium text-neutral-800 transition-colors hover:bg-emerald-100 dark:bg-emerald-950/20 dark:text-neutral-200 dark:hover:bg-emerald-900/40"
        >
          <div
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-emerald-500 text-white shadow-xs"
          >
            <Icon name="whatsappFooter" class="size-4" />
          </div>
          <div class="flex flex-col">
            <span class="font-semibold text-neutral-900 dark:text-white">WhatsApp</span>
            <span class="text-[10px] text-emerald-600 dark:text-emerald-400">Respuesta rápida</span>
          </div>
        </a>

        <!-- Instagram Option -->
        <a
          href={strings.socialLinks.instagram}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-x-3 rounded-xl border border-rose-500/20 bg-rose-50/70 p-2.5 text-xs font-medium text-neutral-800 transition-colors hover:bg-rose-100 dark:bg-rose-950/20 dark:text-neutral-200 dark:hover:bg-rose-900/40"
        >
          <div
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-gradient-to-tr from-amber-400 via-rose-500 to-purple-600 text-white shadow-xs"
          >
            <Icon name="instagramFooter" class="size-4" />
          </div>
          <div class="flex flex-col">
            <span class="font-semibold text-neutral-900 dark:text-white">Instagram</span>
            <span class="text-[10px] text-rose-600 dark:text-rose-400">Mensaje directo</span>
          </div>
        </a>

        <!-- Facebook Option -->
        <a
          href={strings.socialLinks.facebook}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-x-3 rounded-xl border border-blue-500/20 bg-blue-50/70 p-2.5 text-xs font-medium text-neutral-800 transition-colors hover:bg-blue-100 dark:bg-blue-950/20 dark:text-neutral-200 dark:hover:bg-blue-900/40"
        >
          <div
            class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-600 text-white shadow-xs"
          >
            <Icon name="facebookFooter" class="size-4" />
          </div>
          <div class="flex flex-col">
            <span class="font-semibold text-neutral-900 dark:text-white">Messenger</span>
            <span class="text-[10px] text-blue-600 dark:text-blue-400">Hablemos por Facebook</span>
          </div>
        </a>
      </div>

      <div class="border-t border-neutral-100 px-3 py-2 text-center dark:border-neutral-800">
        <a
          href={Astro.currentLocale === 'es' ? '/es/contact' : '/contact'}
          class="block py-1 text-[11px] font-semibold text-orange-600 hover:underline dark:text-orange-400"
        >
          Ver formulario de contacto completo →
        </a>
      </div>
    </div>
  </div>
</div>
