---
const { title = 'Log in' } = Astro.props;

interface Props {
  title?: string;
}
---

<a
  href="/login"
  class="inline-flex h-9 items-center gap-1.5 rounded-xl border border-neutral-200 bg-neutral-50/80 px-3 text-xs font-semibold text-neutral-700 shadow-2xs transition-all hover:border-orange-500 hover:bg-orange-50/40 hover:text-orange-600 focus:outline-none dark:border-neutral-800 dark:bg-neutral-900/90 dark:text-neutral-300 dark:hover:border-orange-500/50 dark:hover:bg-neutral-800 dark:hover:text-orange-400"
>
  <svg
    class="h-3.5 w-3.5 shrink-0 text-neutral-500 transition-colors group-hover:text-orange-500 dark:text-neutral-400"
    fill="none"
    viewBox="0 0 24 24"
    stroke="currentColor"
    stroke-width="2"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
  </svg>
  <span>{title}</span>
</a>
