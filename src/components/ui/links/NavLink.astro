---
// Destructure the properties from Astro.props
const { url, name } = Astro.props;

interface Props {
  url: string;
  name: string;
}

const pathname = Astro.url.pathname;
const isHome = url === '/' || url === '/es' || url === '/es/';
const isActive = isHome ? pathname === url || pathname === `${url}/` : pathname.startsWith(url);
---

<a
  href={url}
  data-astro-prefetch
  class={`inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium transition-all duration-150 ${
    isActive
      ? 'bg-orange-500/10 text-orange-600 font-semibold dark:text-orange-400'
      : 'text-neutral-600 hover:text-neutral-900 hover:bg-neutral-100/80 dark:text-neutral-400 dark:hover:text-neutral-200 dark:hover:bg-neutral-800/60'
  }`}
  aria-current={isActive ? 'page' : undefined}
>
  {name}
</a>
