---
// Importing necessary components
import Meta from '@components/Meta.astro';
import Navbar from '@components/sections/navbar&footer/Navbar.astro';
import FooterSection from '@components/sections/navbar&footer/FooterSection.astro';
import ContactHub from '@components/ui/buttons/ContactHub.astro';
import CookieBanner from '@components/ui/CookieBanner.astro';
import ThemeCustomizerInit from '@components/ui/ThemeCustomizerInit.astro';
import { SITE } from '@data/constants';
import '@styles/global.css';

// Setting expected props
const {
  title = SITE.title,
  meta,
  structuredData,
  lang = 'en',
  customDescription = null,
  customOgTitle = null,
} = Astro.props;

// Interface to type-check the properties
interface Props {
  title?: string;
  meta?: string;
  structuredData?: object;
  lang?: string;
  customDescription?: string | null;
  customOgTitle?: string | null;
}
---

<html lang={lang} class="scrollbar-hide lenis lenis-smooth scroll-pt-16">
  <head>
    {/* Adding metadata to the HTML document */}
    <Meta
      meta={meta}
      structuredData={structuredData}
      customDescription={customDescription}
      customOgTitle={customOgTitle}
    />
    <title>{title}</title>
    <ThemeCustomizerInit />
    <script>
      import '@scripts/lenisSmoothScroll.js';
    </script>
  </head>
  <body
    class="flex min-h-screen flex-col bg-neutral-50 text-neutral-900 transition-colors duration-300 selection:bg-orange-500 selection:text-white dark:bg-neutral-950 dark:text-neutral-200"
  >
    {/* Main Container */}
    <div class="mx-auto flex min-h-screen w-full max-w-7xl flex-col px-4 sm:px-6 lg:px-8">
      <Navbar />
      <main class="grow">
        <slot />
      </main>
    </div>

    <FooterSection />
    <ContactHub />
    <CookieBanner />

    {/* Background Decorative Elements (Pointer events disabled) */}
    <div class="tech-grid pointer-events-none" id="tech-grid"></div>
    <div class="noise-overlay pointer-events-none"></div>
    <div class="custom-cursor pointer-events-none hidden lg:block" id="cursor"></div>

    <div class="blob pointer-events-none top-[-10%] right-[-10%] opacity-40"></div>
    <div
      class="blob pointer-events-none bottom-[-10%] left-[-10%] opacity-20"
      style="animation-delay: -5s; background: linear-gradient(135deg, rgba(234, 88, 12, 0.2), rgba(249, 115, 22, 0.1));"
    >
    </div>

    <script>
      // Preline & Animations Init
      import 'preline';
      import gsap from 'gsap';
      import { initPremiumAnimations } from '@scripts/premiumAnimations.js';
      import { setupSmoothScroll } from '@scripts/lenisScrollTrigger.js';
      import {
        initScrollOrderSections,
        initScrollSectionReveals,
        refreshScrollAnimations,
      } from '@scripts/scrollOrder.js';
      import { initLandoScroll } from '@scripts/landoScroll.js';

      const init = () => {
        try {
          setupSmoothScroll();
          (window as any).HSStaticMethods?.autoInit?.();
          initPremiumAnimations();
          initScrollOrderSections();
          initLandoScroll();
          initScrollSectionReveals();
          refreshScrollAnimations();
        } catch (e) {
          console.warn('Animation init notice:', e);
        }

        // Particle Cursor
        const createParticle = (x: number, y: number) => {
          const particle = document.createElement('div');
          particle.className = 'cursor-particle pointer-events-none';
          document.body.appendChild(particle);

          const size = Math.random() * 6 + 3;
          particle.style.width = `${size}px`;
          particle.style.height = `${size}px`;

          const destinationX = x + (Math.random() - 0.5) * 30;
          const destinationY = y + (Math.random() - 0.5) * 30;

          gsap.set(particle, {
            x: x - size / 2,
            y: y - size / 2,
            opacity: 0.8,
            scale: 1,
            backgroundColor: Math.random() > 0.5 ? '#f97316' : '#fbbf24',
          });

          gsap.to(particle, {
            x: destinationX,
            y: destinationY,
            opacity: 0,
            scale: 0,
            duration: Math.random() * 0.8 + 0.4,
            ease: 'power2.out',
            onComplete: () => particle.remove(),
          });
        };

        const cursor = document.getElementById('cursor');
        const techGrid = document.getElementById('tech-grid');
        let lastX = 0;
        let lastY = 0;

        document.addEventListener('mousemove', e => {
          const { clientX, clientY } = e;

          if (Math.abs(clientX - lastX) > 8 || Math.abs(clientY - lastY) > 8) {
            createParticle(clientX, clientY);
            lastX = clientX;
            lastY = clientY;
          }

          if (techGrid) {
            const xPercent = (clientX / window.innerWidth) * 100;
            const yPercent = (clientY / window.innerHeight) * 100;
            techGrid.style.setProperty('--mouse-x', `${xPercent}%`);
            techGrid.style.setProperty('--mouse-y', `${yPercent}%`);
          }

          if (cursor) {
            gsap.to(cursor, {
              x: clientX - 10,
              y: clientY - 10,
              duration: 0.1,
              ease: 'power2.out',
            });
          }
        });
      };

      document.addEventListener('DOMContentLoaded', init);
      document.addEventListener('astro:page-load', init);
    </script>

    <style is:global>
      /* Smooth reveal fallback to ensure images are always visible */
      .reveal-image {
        clip-path: none !important;
        opacity: 1 !important;
      }
      .scrollbar-hide::-webkit-scrollbar {
        display: none;
      }
      .scrollbar-hide {
        -ms-overflow-style: none;
        scrollbar-width: none;
      }
    </style>
  </body>
</html>
