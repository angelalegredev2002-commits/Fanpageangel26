---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import StatsGrid from '@components/admin/widgets/StatsGrid.astro';
import TrafficChart from '@components/admin/widgets/TrafficChart.astro';
import RecentActivity from '@components/admin/widgets/RecentActivity.astro';

const quickActions = [
  { label: 'Hero Section', href: '/adminpanel/landing/hero', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>`, bg: 'bg-blue-500/10 dark:bg-blue-500/10', text: 'text-blue-500 dark:text-blue-400' },
  { label: 'Planes de Precios', href: '/adminpanel/landing/pricing', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`, bg: 'bg-orange-500/10', text: 'text-orange-500 dark:text-orange-400' },
  { label: 'Características', href: '/adminpanel/landing/features', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>`, bg: 'bg-purple-500/10', text: 'text-purple-500 dark:text-purple-400' },
  { label: 'Testimonios', href: '/adminpanel/landing/testimonials', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>`, bg: 'bg-emerald-500/10', text: 'text-emerald-500 dark:text-emerald-400' },
  { label: 'Media Library', href: '/adminpanel/media', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M7 16a4 4 0 01-.88-7.903A5 5 0 1115.9 6L16 6a5 5 0 011 9.9M15 13l-3-3m0 0l-3 3m3-3v12"/>`, bg: 'bg-rose-500/10', text: 'text-rose-500 dark:text-rose-400' },
  { label: 'FAQs', href: '/adminpanel/landing/faqs', icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>`, bg: 'bg-amber-500/10', text: 'text-amber-500 dark:text-amber-400' },
];
---

<AdminLayout title="Dashboard">
  <!-- Page Header -->
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <div class="mb-1 flex items-center gap-2">
        <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-500"></span>
        <span class="text-xs font-medium text-emerald-600 dark:text-emerald-400">Sistema en línea</span>
      </div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Dashboard
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Resumen general y métricas clave de la plataforma.
      </p>
    </div>
    <div class="flex items-center gap-2">
      <a
        href="/"
        target="_blank"
        class="flex items-center gap-1.5 rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-medium text-neutral-700 shadow-xs transition-all hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 dark:hover:bg-neutral-700/60"
      >
        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
        </svg>
        Ver Sitio Público
      </a>
    </div>
  </div>

  <!-- Stats Grid -->
  <StatsGrid />

  <!-- Quick Actions -->
  <div class="mb-6">
    <h2 class="mb-3 text-xs font-semibold tracking-wider text-neutral-500 uppercase dark:text-neutral-400">
      Acciones Rápidas
    </h2>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
      {
        quickActions.map((action) => (
          <a
            href={action.href}
            class={`group flex flex-col items-center gap-2.5 rounded-xl border border-neutral-200/80 bg-white p-3.5 text-center shadow-xs transition-all duration-200 hover:border-neutral-300 hover:shadow-sm dark:border-neutral-800/80 dark:bg-neutral-900/60 dark:hover:border-neutral-700`}
          >
            <div class={`flex h-9 w-9 items-center justify-center rounded-lg ${action.bg} transition-transform group-hover:scale-105`}>
              <svg class={`h-4 w-4 ${action.text}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={action.icon} />
            </div>
            <span class="text-xs font-medium text-neutral-700 dark:text-neutral-300">
              {action.label}
            </span>
          </a>
        ))
      }
    </div>
  </div>

  <!-- Main Content Grid -->
  <div class="grid grid-cols-1 gap-5 lg:grid-cols-3">
    <TrafficChart />
    <RecentActivity />
  </div>

  <!-- Site Status Bar -->
  <div class="mt-6 rounded-xl border border-neutral-200/80 bg-white p-4 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h3 class="text-xs font-semibold text-neutral-700 dark:text-neutral-300">Estado de Servicios</h3>
      <div class="flex flex-wrap items-center gap-5 text-xs text-neutral-500 dark:text-neutral-400">
        {[
          { label: 'Sitio Web', status: 'online', detail: 'angelalegre.com' },
          { label: 'Deploy', status: 'online', detail: 'Vercel v2.4.1' },
          { label: 'Base de Datos', status: 'online', detail: 'JSON Engine' },
          { label: 'CDN Edge', status: 'online', detail: 'Latencia < 80ms' },
        ].map(item => (
          <div class="flex items-center gap-1.5">
            <span class={`h-1.5 w-1.5 rounded-full ${item.status === 'online' ? 'bg-emerald-500' : 'bg-rose-500'}`} />
            <span>{item.label}:</span>
            <span class="font-medium text-neutral-700 dark:text-neutral-300">{item.detail}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</AdminLayout>
