---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB, saveDB } from '../../../utils/db';

let db = getDB();
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const rawData = formData.get('faqsData');
  if (rawData) {
    try {
      const parsed = JSON.parse(rawData.toString());
      if (!db.landing) db.landing = {};
      db.landing.faqs_es = parsed.es;
      db.landing.faqs_en = parsed.en;
      saveDB(db);
      success = true;
    } catch (e) {
      console.error('Error saving FAQs', e);
    }
  }
}

const faqsES = db.landing?.faqs_es || [];
const faqsEN = db.landing?.faqs_en || [];
---

<AdminLayout title="Preguntas Frecuentes">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Preguntas Frecuentes (FAQs)
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Administra las preguntas y respuestas mostradas en la landing page.
      </p>
    </div>
    {
      success && (
        <span class="flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          ¡Cambios Guardados!
        </span>
      )
    }
  </div>

  <div
    id="faqs-app"
    class="space-y-6"
    data-es={JSON.stringify(faqsES)}
    data-en={JSON.stringify(faqsEN)}
  >
    <!-- Language Toggle -->
    <div class="flex gap-2">
      <button
        id="btn-es"
        type="button"
        class="rounded-lg border border-orange-500 bg-orange-500/10 px-4 py-1.5 text-xs font-semibold text-orange-600 dark:text-orange-400"
      >
        Español
      </button>
      <button
        id="btn-en"
        type="button"
        class="rounded-lg border border-neutral-200 bg-neutral-100/70 px-4 py-1.5 text-xs font-medium text-neutral-600 hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700"
      >
        English
      </button>
    </div>

    <!-- FAQs Box -->
    <div
      class="rounded-xl border border-neutral-200/80 bg-white p-5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60"
    >
      <div id="faqs-container" class="mb-4 space-y-4"></div>
      
      <button
        id="add-faq"
        type="button"
        class="w-full rounded-xl border border-dashed border-neutral-300 bg-neutral-50/50 py-3 text-xs font-medium text-neutral-600 transition-all hover:border-orange-500 hover:bg-orange-50/40 hover:text-orange-600 dark:border-neutral-700 dark:bg-neutral-800/40 dark:text-neutral-300 dark:hover:border-orange-500/50 dark:hover:bg-neutral-800 dark:hover:text-orange-400"
      >
        + Añadir Nueva Pregunta
      </button>
    </div>

    <form
      method="POST"
      id="faqs-form"
      class="flex justify-end pt-2"
    >
      <input type="hidden" name="faqsData" id="faqs-data-input" />
      <button
        type="submit"
        class="rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-2.5 text-xs font-semibold text-white shadow-md shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
      >
        Guardar Cambios
      </button>
    </form>
  </div>

  <script is:inline>
    const app = document.getElementById('faqs-app');
    if (app) {
      let data = {
        es: JSON.parse(app.dataset.es),
        en: JSON.parse(app.dataset.en),
      };
      let currentLang = 'es';

      const container = document.getElementById('faqs-container');
      const btnEs = document.getElementById('btn-es');
      const btnEn = document.getElementById('btn-en');
      const addBtn = document.getElementById('add-faq');
      const form = document.getElementById('faqs-form');
      const input = document.getElementById('faqs-data-input');

      function escapeHtml(unsafe) {
        return (unsafe || '')
          .toString()
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      function render() {
        container.innerHTML = '';
        const list = data[currentLang] || [];
        list.forEach((faq, index) => {
          const div = document.createElement('div');
          div.className =
            'rounded-xl border border-neutral-200/90 bg-neutral-50/70 p-4.5 dark:border-neutral-800 dark:bg-neutral-800/40 relative';

          div.innerHTML = `
            <div class="flex items-center justify-between border-b border-neutral-200/60 dark:border-neutral-700/60 pb-2.5 mb-3">
              <span class="text-xs font-semibold text-neutral-700 dark:text-neutral-300">Pregunta #${index + 1}</span>
              <button type="button" class="text-xs font-medium text-rose-500 hover:text-rose-600 dark:text-rose-400" data-remove="${index}">Eliminar</button>
            </div>
            <div class="space-y-3">
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Pregunta</label>
                <input type="text" value="${escapeHtml(faq.question)}" data-field="question" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
              </div>
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Respuesta</label>
                <textarea rows="3" data-field="answer" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">${escapeHtml(faq.answer)}</textarea>
              </div>
            </div>
          `;
          container.appendChild(div);
        });

        // Add event listeners
        container.querySelectorAll('input, textarea').forEach(el => {
          el.addEventListener('input', e => {
            const idx = e.target.dataset.index;
            const field = e.target.dataset.field;
            data[currentLang][idx][field] = e.target.value;
          });
        });

        container.querySelectorAll('[data-remove]').forEach(btn => {
          btn.addEventListener('click', e => {
            const idx = e.target.dataset.remove;
            data[currentLang].splice(idx, 1);
            render();
          });
        });
      }

      addBtn.onclick = () => {
        data[currentLang].push({
          question: 'Nueva Pregunta',
          answer: 'Nueva Respuesta',
        });
        render();
      };

      btnEs.onclick = () => {
        currentLang = 'es';
        btnEs.className = 'rounded-lg border border-orange-500 bg-orange-500/10 px-4 py-1.5 text-xs font-semibold text-orange-600 dark:text-orange-400';
        btnEn.className = 'rounded-lg border border-neutral-200 bg-neutral-100/70 px-4 py-1.5 text-xs font-medium text-neutral-600 hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700';
        render();
      };

      btnEn.onclick = () => {
        currentLang = 'en';
        btnEn.className = 'rounded-lg border border-orange-500 bg-orange-500/10 px-4 py-1.5 text-xs font-semibold text-orange-600 dark:text-orange-400';
        btnEs.className = 'rounded-lg border border-neutral-200 bg-neutral-100/70 px-4 py-1.5 text-xs font-medium text-neutral-600 hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700';
        render();
      };

      form.onsubmit = () => {
        input.value = JSON.stringify(data);
      };

      render();
    }
  </script>
</AdminLayout>
