---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB, saveDB } from '../../../utils/db';

let db = getDB();
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  const rawFeatures = formData.get('featuresData');
  if (rawFeatures) {
    try {
      const parsedFeatures = JSON.parse(rawFeatures.toString());
      if (!db.landing) db.landing = {};
      db.landing.features_es = parsedFeatures.es;
      db.landing.features_en = parsedFeatures.en;
      saveDB(db);
      success = true;
    } catch (e) {
      console.error('Error saving features', e);
    }
  }

  const rawTabs = formData.get('featureTabsData');
  if (rawTabs) {
    try {
      const parsedTabs = JSON.parse(rawTabs.toString());
      db.landing.featureTabs = parsedTabs;
      saveDB(db);
      success = true;
    } catch (e) {
      console.error('Error saving tabs', e);
    }
  }
}

const featuresES = db.landing?.features_es || [];
const featuresEN = db.landing?.features_en || [];
const featureTabs = db.landing?.featureTabs || [];
---

<AdminLayout title="Características Principales">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Características Principales
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Administra las características generales y las pestañas interactivas de la landing page.
      </p>
    </div>
    {
      success && (
        <span class="flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          ¡Cambios Guardados!
        </span>
      )
    }
  </div>

  <div
    id="features-app"
    class="space-y-6"
    data-features-es={JSON.stringify(featuresES)}
    data-features-en={JSON.stringify(featuresEN)}
    data-tabs={JSON.stringify(featureTabs)}
  >
    <!-- FEATURES SECTION -->
    <div
      class="rounded-xl border border-neutral-200/80 bg-white p-5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60"
    >
      <div class="mb-4 flex flex-wrap items-center justify-between gap-3 border-b border-neutral-100 pb-3 dark:border-neutral-800">
        <div>
          <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">
            Lista de Características
          </h2>
          <p class="text-xs text-neutral-500 dark:text-neutral-400">
            Puntos destacados de tus servicios o soluciones.
          </p>
        </div>

        <div class="flex gap-2">
          <button
            id="feat-btn-es"
            type="button"
            class="rounded-lg border border-orange-500 bg-orange-500/10 px-3 py-1 text-xs font-semibold text-orange-600 dark:text-orange-400"
          >
            Español
          </button>
          <button
            id="feat-btn-en"
            type="button"
            class="rounded-lg border border-neutral-200 bg-neutral-100/70 px-3 py-1 text-xs font-medium text-neutral-600 hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700"
          >
            English
          </button>
        </div>
      </div>

      <div id="features-container" class="mb-4 space-y-3"></div>
      
      <button
        id="add-feature"
        type="button"
        class="w-full rounded-xl border border-dashed border-neutral-300 bg-neutral-50/50 py-3 text-xs font-medium text-neutral-600 transition-all hover:border-orange-500 hover:bg-orange-50/40 hover:text-orange-600 dark:border-neutral-700 dark:bg-neutral-800/40 dark:text-neutral-300 dark:hover:border-orange-500/50 dark:hover:bg-neutral-800 dark:hover:text-orange-400"
      >
        + Añadir Característica
      </button>
    </div>

    <!-- TABS SECTION -->
    <div
      class="rounded-xl border border-neutral-200/80 bg-white p-5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60"
    >
      <div class="mb-4 border-b border-neutral-100 pb-3 dark:border-neutral-800">
        <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">
          Pestañas Interactivas (Feature Tabs)
        </h2>
        <p class="text-xs text-neutral-500 dark:text-neutral-400">
          Paneles interactivos con imágenes y detalles técnicos.
        </p>
      </div>

      <div
        id="tabs-container"
        class="mb-4 grid grid-cols-1 gap-4 md:grid-cols-2"
      >
      </div>

      <button
        id="add-tab"
        type="button"
        class="w-full rounded-xl border border-dashed border-neutral-300 bg-neutral-50/50 py-3 text-xs font-medium text-neutral-600 transition-all hover:border-orange-500 hover:bg-orange-50/40 hover:text-orange-600 dark:border-neutral-700 dark:bg-neutral-800/40 dark:text-neutral-300 dark:hover:border-orange-500/50 dark:hover:bg-neutral-800 dark:hover:text-orange-400"
      >
        + Añadir Pestaña Interactiva
      </button>
    </div>

    <!-- FORM -->
    <form
      method="POST"
      id="features-form"
      class="flex justify-end pt-2"
    >
      <input type="hidden" name="featuresData" id="features-data-input" />
      <input type="hidden" name="featureTabsData" id="tabs-data-input" />
      <button
        type="submit"
        class="rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-2.5 text-xs font-semibold text-white shadow-md shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
      >
        Guardar Cambios
      </button>
    </form>
  </div>

  <script is:inline>
    const app = document.getElementById('features-app');
    if (app) {
      let dataFeat = {
        es: JSON.parse(app.dataset.featuresEs),
        en: JSON.parse(app.dataset.featuresEn),
      };
      let dataTabs = JSON.parse(app.dataset.tabs);
      let currentLang = 'es';

      function escapeHtml(unsafe) {
        return (unsafe || '')
          .toString()
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      const fContainer = document.getElementById('features-container');
      const tContainer = document.getElementById('tabs-container');
      const form = document.getElementById('features-form');

      function renderFeatures() {
        if (!fContainer) return;
        fContainer.innerHTML = '';
        const list = dataFeat[currentLang] || [];
        list.forEach((feat, index) => {
          const div = document.createElement('div');
          div.className =
            'rounded-xl border border-neutral-200/90 bg-neutral-50/70 p-3.5 flex gap-3 items-start dark:border-neutral-800 dark:bg-neutral-800/40';
          div.innerHTML = `
            <div class="flex-1 space-y-2.5">
              <input type="text" placeholder="Título (ej: Robust Features)" value="${escapeHtml(feat.heading)}" data-type="feat" data-field="heading" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs font-semibold text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
              <textarea placeholder="Descripción" rows="2" data-type="feat" data-field="content" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">${escapeHtml(feat.content)}</textarea>
              <input type="text" placeholder="Ícono SVG (ej: tools, dashboard, house)" value="${escapeHtml(feat.svg)}" data-type="feat" data-field="svg" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
            </div>
            <button type="button" class="text-xs font-medium text-rose-500 hover:text-rose-600 dark:text-rose-400 p-1" onclick="window.removeFeat(${index})">✕</button>
          `;
          fContainer.appendChild(div);
        });
        attachFeatEvents();
      }

      function renderTabs() {
        tContainer.innerHTML = '';
        dataTabs.forEach((tab, index) => {
          const div = document.createElement('div');
          div.className =
            'rounded-xl border border-neutral-200/90 bg-neutral-50/70 p-4.5 dark:border-neutral-800 dark:bg-neutral-800/40 relative';
          div.innerHTML = `
            <div class="flex items-center justify-between border-b border-neutral-200/60 dark:border-neutral-700/60 pb-2 mb-3">
              <span class="text-xs font-semibold text-neutral-700 dark:text-neutral-300">Pestaña #${index + 1}</span>
              <button type="button" class="text-xs font-medium text-rose-500 hover:text-rose-600 dark:text-rose-400" onclick="window.removeTab(${index})">Eliminar</button>
            </div>
            <div class="space-y-3">
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Título</label>
                <input type="text" value="${escapeHtml(tab.heading)}" data-type="tab" data-field="heading" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
              </div>
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Contenido</label>
                <textarea rows="2" data-type="tab" data-field="content" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">${escapeHtml(tab.content)}</textarea>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Icono SVG</label>
                  <input type="text" value="${escapeHtml(tab.svg)}" data-type="tab" data-field="svg" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
                </div>
                <div>
                  <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">URL Imagen</label>
                  <input type="text" value="${escapeHtml(tab.src)}" data-type="tab" data-field="src" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
                </div>
              </div>
              <div class="pt-1">
                <label class="flex items-center gap-2 text-xs font-medium text-neutral-700 dark:text-neutral-300 cursor-pointer">
                  <input type="checkbox" ${tab.first ? 'checked' : ''} data-type="tab" data-field="first" data-index="${index}" class="h-3.5 w-3.5 rounded-sm border-neutral-300 text-orange-600 accent-orange-500 focus:ring-orange-500">
                  ¿Activa por defecto?
                </label>
              </div>
            </div>
          `;
          tContainer.appendChild(div);
        });
        attachTabEvents();
      }

      function attachFeatEvents() {
        fContainer.querySelectorAll('input, textarea').forEach(el => {
          el.addEventListener('input', e => {
            const idx = e.target.dataset.index;
            dataFeat[currentLang][idx][e.target.dataset.field] = e.target.value;
          });
        });
      }

      function attachTabEvents() {
        tContainer.querySelectorAll('input, textarea').forEach(el => {
          el.addEventListener('input', e => {
            const idx = e.target.dataset.index;
            const field = e.target.dataset.field;
            if (e.target.type === 'checkbox') {
              dataTabs[idx][field] = e.target.checked;
              if (field === 'first' && e.target.checked) {
                dataTabs.forEach((t, i) => {
                  if (i != idx) t.first = false;
                });
                renderTabs();
              }
            } else {
              dataTabs[idx][field] = e.target.value;
            }
          });
        });
      }

      window.removeFeat = idx => {
        dataFeat[currentLang].splice(idx, 1);
        renderFeatures();
      };
      window.removeTab = idx => {
        dataTabs.splice(idx, 1);
        renderTabs();
      };

      document.getElementById('add-feature').onclick = () => {
        dataFeat[currentLang].push({
          heading: 'Nueva Característica',
          content: 'Descripción...',
          svg: 'tools',
        });
        renderFeatures();
      };

      document.getElementById('add-tab').onclick = () => {
        dataTabs.push({
          heading: 'Nueva Pestaña',
          content: '',
          svg: 'tools',
          src: '/images/automated-tools.jpg',
        });
        renderTabs();
      };

      const btnEs = document.getElementById('feat-btn-es');
      const btnEn = document.getElementById('feat-btn-en');
      btnEs.onclick = () => {
        currentLang = 'es';
        btnEs.className = 'rounded-lg border border-orange-500 bg-orange-500/10 px-3 py-1 text-xs font-semibold text-orange-600 dark:text-orange-400';
        btnEn.className = 'rounded-lg border border-neutral-200 bg-neutral-100/70 px-3 py-1 text-xs font-medium text-neutral-600 hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700';
        renderFeatures();
      };
      btnEn.onclick = () => {
        currentLang = 'en';
        btnEn.className = 'rounded-lg border border-orange-500 bg-orange-500/10 px-3 py-1 text-xs font-semibold text-orange-600 dark:text-orange-400';
        btnEs.className = 'rounded-lg border border-neutral-200 bg-neutral-100/70 px-3 py-1 text-xs font-medium text-neutral-600 hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700';
        renderFeatures();
      };

      form.onsubmit = () => {
        document.getElementById('features-data-input').value =
          JSON.stringify(dataFeat);
        document.getElementById('tabs-data-input').value =
          JSON.stringify(dataTabs);
      };

      renderFeatures();
      renderTabs();
    }
  </script>
</AdminLayout>
