---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB, saveDB } from '../../../utils/db';

let db = getDB();
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (!db.landing) db.landing = {};

  db.landing.heroTitle_es = formData.get('heroTitle_es') as string;
  db.landing.heroSubtitle_es = formData.get('heroSubtitle_es') as string;
  db.landing.heroPrimaryBtn_es = formData.get('heroPrimaryBtn_es') as string;
  db.landing.heroSecondaryBtn_es = formData.get(
    'heroSecondaryBtn_es'
  ) as string;

  db.landing.heroTitle_en = formData.get('heroTitle_en') as string;
  db.landing.heroSubtitle_en = formData.get('heroSubtitle_en') as string;
  db.landing.heroPrimaryBtn_en = formData.get('heroPrimaryBtn_en') as string;
  db.landing.heroSecondaryBtn_en = formData.get(
    'heroSecondaryBtn_en'
  ) as string;

  saveDB(db);
  success = true;
}
---

<AdminLayout title="Configuración de Hero">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Hero Section
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Gestiona los textos principales y botones de llamada a la acción en la portada.
      </p>
    </div>
    {
      success && (
        <span class="flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          ¡Cambios Guardados!
        </span>
      )
    }
  </div>

  <div
    class="rounded-xl border border-neutral-200/80 bg-white p-6 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60"
  >
    <form method="POST" class="space-y-6">
      <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
        <!-- Español -->
        <div class="space-y-4 rounded-xl border border-neutral-200/90 bg-neutral-50/70 p-5 dark:border-neutral-800 dark:bg-neutral-800/40">
          <h3
            class="border-b border-neutral-200/60 pb-2.5 text-sm font-semibold text-orange-500 dark:border-neutral-700/60 dark:text-orange-400"
          >
            Español
          </h3>
          <div>
            <label class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
              >Título Principal (HTML permitido)</label
            >
            <input
              type="text"
              name="heroTitle_es"
              value={db.landing?.heroTitle_es || ''}
              class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
            />
          </div>
          <div>
            <label class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
              >Subtítulo</label
            >
            <textarea
              name="heroSubtitle_es"
              rows="3"
              class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              >{db.landing?.heroSubtitle_es || ''}</textarea
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
                >Botón Principal</label
              >
              <input
                type="text"
                name="heroPrimaryBtn_es"
                value={db.landing?.heroPrimaryBtn_es || ''}
                class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
                >Botón Secundario</label
              >
              <input
                type="text"
                name="heroSecondaryBtn_es"
                value={db.landing?.heroSecondaryBtn_es || ''}
                class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              />
            </div>
          </div>
        </div>

        <!-- English -->
        <div class="space-y-4 rounded-xl border border-neutral-200/90 bg-neutral-50/70 p-5 dark:border-neutral-800 dark:bg-neutral-800/40">
          <h3
            class="border-b border-neutral-200/60 pb-2.5 text-sm font-semibold text-orange-500 dark:border-neutral-700/60 dark:text-orange-400"
          >
            English
          </h3>
          <div>
            <label class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
              >Main Title (HTML allowed)</label
            >
            <input
              type="text"
              name="heroTitle_en"
              value={db.landing?.heroTitle_en || ''}
              class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
            />
          </div>
          <div>
            <label class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
              >Subtitle</label
            >
            <textarea
              name="heroSubtitle_en"
              rows="3"
              class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              >{db.landing?.heroSubtitle_en || ''}</textarea
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
                >Primary Button</label
              >
              <input
                type="text"
                name="heroPrimaryBtn_en"
                value={db.landing?.heroPrimaryBtn_en || ''}
                class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
                >Secondary Button</label
              >
              <input
                type="text"
                name="heroSecondaryBtn_en"
                value={db.landing?.heroSecondaryBtn_en || ''}
                class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="flex justify-end border-t border-neutral-100 pt-4 dark:border-neutral-800">
        <button
          type="submit"
          class="rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-2.5 text-xs font-semibold text-white shadow-md shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
        >
          Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
