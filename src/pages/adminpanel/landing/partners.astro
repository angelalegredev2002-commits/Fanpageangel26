---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB, saveDB } from '../../../utils/db';

let db = getDB();
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  const rawPartners = formData.get('partnersData');
  if (rawPartners) {
    try {
      if (!db.landing) db.landing = {};
      db.landing.partners = JSON.parse(rawPartners.toString());
      saveDB(db);
      success = true;
    } catch (e) {
      console.error('Error saving partners', e);
    }
  }
}

const partners = db.landing?.partners || [];
---

<AdminLayout title="Clientes y Partners">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Clientes / Partners
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Administra los logotipos de empresas y clientes que confían en tus servicios.
      </p>
    </div>
    {
      success && (
        <span class="flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          ¡Cambios Guardados!
        </span>
      )
    }
  </div>

  <div
    id="partners-app"
    class="space-y-6"
    data-partners={JSON.stringify(partners)}
  >
    <div
      class="rounded-xl border border-neutral-200/80 bg-white p-5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60"
    >
      <div id="partners-container" class="mb-4 space-y-4"></div>
      
      <button
        id="add-partner"
        type="button"
        class="w-full rounded-xl border border-dashed border-neutral-300 bg-neutral-50/50 py-3 text-xs font-medium text-neutral-600 transition-all hover:border-orange-500 hover:bg-orange-50/40 hover:text-orange-600 dark:border-neutral-700 dark:bg-neutral-800/40 dark:text-neutral-300 dark:hover:border-orange-500/50 dark:hover:bg-neutral-800 dark:hover:text-orange-400"
      >
        + Añadir Nuevo Partner
      </button>
    </div>

    <form
      method="POST"
      id="partners-form"
      class="flex justify-end pt-2"
    >
      <input type="hidden" name="partnersData" id="partners-data-input" />
      <button
        type="submit"
        class="rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-2.5 text-xs font-semibold text-white shadow-md shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
      >
        Guardar Cambios
      </button>
    </form>
  </div>

  <script is:inline>
    const app = document.getElementById('partners-app');
    if (app) {
      let dataPartners = JSON.parse(app.dataset.partners);

      function escapeHtml(unsafe) {
        return (unsafe || '')
          .toString()
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      const container = document.getElementById('partners-container');
      const form = document.getElementById('partners-form');

      function renderPartners() {
        container.innerHTML = '';
        dataPartners.forEach((p, index) => {
          const div = document.createElement('div');
          div.className =
            'rounded-xl border border-neutral-200/90 bg-neutral-50/70 p-4.5 dark:border-neutral-800 dark:bg-neutral-800/40 relative';
          div.innerHTML = `
            <div class="flex items-center justify-between border-b border-neutral-200/60 dark:border-neutral-700/60 pb-2.5 mb-3">
              <span class="text-xs font-semibold text-neutral-700 dark:text-neutral-300">Partner #${index + 1}: ${escapeHtml(p.name || 'Sin nombre')}</span>
              <button type="button" class="text-xs font-medium text-rose-500 hover:text-rose-600 dark:text-rose-400" onclick="window.removePartner(${index})">Eliminar</button>
            </div>
            <div class="space-y-3">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                <div>
                  <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Nombre de Empresa</label>
                  <input type="text" value="${escapeHtml(p.name)}" data-field="name" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
                </div>
                <div>
                  <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Enlace (URL)</label>
                  <input type="text" value="${escapeHtml(p.href)}" data-field="href" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
                </div>
              </div>
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Icono / Logo (Código SVG o tag &lt;img&gt;)</label>
                <textarea rows="2" data-field="icon" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 font-mono text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">${escapeHtml(p.icon)}</textarea>
              </div>
            </div>
          `;
          container.appendChild(div);
        });
        attachEvents();
      }

      function attachEvents() {
        container.querySelectorAll('input, textarea').forEach(el => {
          el.addEventListener('input', e => {
            const idx = e.target.dataset.index;
            dataPartners[idx][e.target.dataset.field] = e.target.value;
          });
        });
      }

      window.removePartner = idx => {
        dataPartners.splice(idx, 1);
        renderPartners();
      };

      document.getElementById('add-partner').onclick = () => {
        dataPartners.push({
          name: 'Nuevo Partner',
          href: '#',
          icon: '<img src="/images/clients/client-1.png" alt="Partner" class="mx-auto h-10 w-auto grayscale object-contain dark:invert" />',
        });
        renderPartners();
      };

      form.onsubmit = () => {
        document.getElementById('partners-data-input').value =
          JSON.stringify(dataPartners);
      };

      renderPartners();
    }
  </script>
</AdminLayout>
