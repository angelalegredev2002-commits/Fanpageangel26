---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB, saveDB } from '../../../utils/db';

let db = getDB();
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  const rawPricing = formData.get('pricingData');
  if (rawPricing) {
    try {
      const parsedPricing = JSON.parse(rawPricing.toString());
      if (!db.landing) db.landing = {};
      db.landing.pricing_es = parsedPricing.es;
      db.landing.pricing_en = parsedPricing.en;
      saveDB(db);
      success = true;
    } catch (e) {
      console.error('Error saving pricing', e);
    }
  }
}

const pricingES = db.landing?.pricing_es || { plans: [] };
const pricingEN = db.landing?.pricing_en || { plans: [] };
---

<AdminLayout title="Gestión de Precios">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Planes de Precios
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Administra los paquetes, tarifas y características que se muestran en la sección de precios.
      </p>
    </div>
    {
      success && (
        <span class="flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          ¡Cambios Guardados!
        </span>
      )
    }
  </div>

  <div
    id="pricing-app"
    class="space-y-6"
    data-es={JSON.stringify(pricingES)}
    data-en={JSON.stringify(pricingEN)}
  >
    <!-- Language Toggle -->
    <div class="flex gap-2">
      <button
        id="btn-es"
        type="button"
        class="rounded-lg border border-orange-500 bg-orange-500/10 px-4 py-1.5 text-xs font-semibold text-orange-600 dark:text-orange-400"
      >
        Español
      </button>
      <button
        id="btn-en"
        type="button"
        class="rounded-lg border border-neutral-200 bg-neutral-100/70 px-4 py-1.5 text-xs font-medium text-neutral-600 hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700"
      >
        English
      </button>
    </div>

    <!-- Plans Box -->
    <div
      class="rounded-xl border border-neutral-200/80 bg-white p-5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60"
    >
      <div id="plans-container" class="mb-4 space-y-4"></div>
      
      <button
        id="add-plan"
        type="button"
        class="w-full rounded-xl border border-dashed border-neutral-300 bg-neutral-50/50 py-3 text-xs font-medium text-neutral-600 transition-all hover:border-orange-500 hover:bg-orange-50/40 hover:text-orange-600 dark:border-neutral-700 dark:bg-neutral-800/40 dark:text-neutral-300 dark:hover:border-orange-500/50 dark:hover:bg-neutral-800 dark:hover:text-orange-400"
      >
        + Añadir Nuevo Plan
      </button>
    </div>

    <form
      method="POST"
      id="pricing-form"
      class="flex justify-end pt-2"
    >
      <input type="hidden" name="pricingData" id="pricing-data-input" />
      <button
        type="submit"
        class="rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-2.5 text-xs font-semibold text-white shadow-md shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
      >
        Guardar Cambios
      </button>
    </form>
  </div>

  <script is:inline>
    const app = document.getElementById('pricing-app');
    if (app) {
      let data = {
        es: JSON.parse(app.dataset.es),
        en: JSON.parse(app.dataset.en),
      };
      if (!data.es.plans) data.es.plans = [];
      if (!data.en.plans) data.en.plans = [];

      let currentLang = 'es';

      function escapeHtml(unsafe) {
        return (unsafe || '')
          .toString()
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;')
          .replace(/'/g, '&#039;');
      }

      const container = document.getElementById('plans-container');
      const form = document.getElementById('pricing-form');
      const input = document.getElementById('pricing-data-input');

      function renderPlans() {
        container.innerHTML = '';
        const list = data[currentLang].plans || [];
        list.forEach((plan, index) => {
          const div = document.createElement('div');
          div.className =
            'rounded-xl border border-neutral-200/90 bg-neutral-50/70 p-5 dark:border-neutral-800 dark:bg-neutral-800/40 relative';
          div.innerHTML = `
            <div class="flex items-center justify-between border-b border-neutral-200/60 dark:border-neutral-700/60 pb-2.5 mb-3">
              <span class="text-xs font-semibold text-neutral-700 dark:text-neutral-300">Plan: ${escapeHtml(plan.name || 'Sin nombre')}</span>
              <button type="button" class="text-xs font-medium text-rose-500 hover:text-rose-600 dark:text-rose-400" onclick="window.removePlan(${index})">Eliminar Plan</button>
            </div>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Nombre del Plan</label>
                <input type="text" value="${escapeHtml(plan.name)}" data-field="name" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
              </div>
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Descripción (Subtítulo)</label>
                <input type="text" value="${escapeHtml(plan.description)}" data-field="description" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
              </div>
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Precio (ej: S/ 99)</label>
                <input type="text" value="${escapeHtml(plan.price)}" data-field="price" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
              </div>
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Céntimos (ej: .00)</label>
                <input type="text" value="${escapeHtml(plan.cents)}" data-field="cents" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
              </div>
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Frecuencia (ej: PEN / mes)</label>
                <input type="text" value="${escapeHtml(plan.billingFrequency)}" data-field="billingFrequency" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
              </div>
              <div>
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Texto del Botón</label>
                <input type="text" value="${escapeHtml(plan.purchaseBtnTitle)}" data-field="purchaseBtnTitle" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
              </div>
              <div class="md:col-span-2">
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Enlace del Botón</label>
                <input type="text" value="${escapeHtml(plan.purchaseLink)}" data-field="purchaseLink" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">
              </div>
              <div class="md:col-span-2">
                <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Características (Una por línea)</label>
                <textarea rows="4" data-field="features" data-index="${index}" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">${escapeHtml((plan.features || []).join('\n'))}</textarea>
              </div>
              <div class="md:col-span-2 flex items-center gap-2 mt-1">
                <input type="checkbox" ${plan.highlight ? 'checked' : ''} data-field="highlight" data-index="${index}" class="h-4 w-4 rounded-sm border-neutral-300 text-orange-600 accent-orange-500 focus:ring-orange-500">
                <label class="text-xs font-medium text-neutral-700 dark:text-neutral-300">Resaltar este plan como destacado</label>
              </div>
            </div>
          `;
          container.appendChild(div);
        });
        attachEvents();
      }

      function attachEvents() {
        container.querySelectorAll('input, textarea').forEach(el => {
          el.addEventListener('input', e => {
            const idx = e.target.dataset.index;
            const field = e.target.dataset.field;

            if (e.target.type === 'checkbox') {
              data[currentLang].plans[idx][field] = e.target.checked;
            } else if (field === 'features') {
              data[currentLang].plans[idx][field] = e.target.value
                .split('\n')
                .filter(s => s.trim());
            } else {
              data[currentLang].plans[idx][field] = e.target.value;
            }
          });
        });
      }

      window.removePlan = idx => {
        data[currentLang].plans.splice(idx, 1);
        renderPlans();
      };

      document.getElementById('add-plan').onclick = () => {
        data[currentLang].plans.push({
          name: 'Nuevo Plan',
          description: '',
          price: '0',
          cents: '.00',
          billingFrequency: '/ mes',
          features: [],
          purchaseBtnTitle: 'Comprar',
          purchaseLink: '#',
          highlight: false,
        });
        renderPlans();
      };

      const btnEs = document.getElementById('btn-es');
      const btnEn = document.getElementById('btn-en');
      btnEs.onclick = () => {
        currentLang = 'es';
        btnEs.className = 'rounded-lg border border-orange-500 bg-orange-500/10 px-4 py-1.5 text-xs font-semibold text-orange-600 dark:text-orange-400';
        btnEn.className = 'rounded-lg border border-neutral-200 bg-neutral-100/70 px-4 py-1.5 text-xs font-medium text-neutral-600 hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700';
        renderPlans();
      };
      btnEn.onclick = () => {
        currentLang = 'en';
        btnEn.className = 'rounded-lg border border-orange-500 bg-orange-500/10 px-4 py-1.5 text-xs font-semibold text-orange-600 dark:text-orange-400';
        btnEs.className = 'rounded-lg border border-neutral-200 bg-neutral-100/70 px-4 py-1.5 text-xs font-medium text-neutral-600 hover:bg-neutral-200 dark:border-neutral-800 dark:bg-neutral-800 dark:text-neutral-400 dark:hover:bg-neutral-700';
        renderPlans();
      };

      form.onsubmit = () => {
        input.value = JSON.stringify(data);
      };

      renderPlans();
    }
  </script>
</AdminLayout>
