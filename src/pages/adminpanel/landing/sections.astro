---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB, saveDB } from '../../../utils/db';

let db = getDB();
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (!db.landing) db.landing = {};

  // Spanish
  db.landing.announcementBtn_es = formData.get('announcementBtn_es') as string;
  db.landing.announcementUrl = formData.get('announcementUrl') as string;
  db.landing.clientsTitle_es = formData.get('clientsTitle_es') as string;
  db.landing.clientsSubtitle_es = formData.get('clientsSubtitle_es') as string;
  db.landing.featuresTitle_es = formData.get('featuresTitle_es') as string;
  db.landing.featuresSubtitle_es = formData.get('featuresSubtitle_es') as string;
  db.landing.featuresNavsTitle_es = formData.get('featuresNavsTitle_es') as string;
  db.landing.testimonialsTitle_es = formData.get('testimonialsTitle_es') as string;
  db.landing.testimonialsSubtitle_es = formData.get('testimonialsSubtitle_es') as string;
  db.landing.pricingTitle_es = formData.get('pricingTitle_es') as string;
  db.landing.pricingSubtitle_es = formData.get('pricingSubtitle_es') as string;
  db.landing.pricingThirdOption_es = formData.get('pricingThirdOption_es') as string;
  db.landing.pricingBtnText_es = formData.get('pricingBtnText_es') as string;
  db.landing.faqTitle_es = formData.get('faqTitle_es') as string;
  db.landing.ctaTitle_es = formData.get('ctaTitle_es') as string;
  db.landing.ctaSubtitle_es = formData.get('ctaSubtitle_es') as string;

  // English
  db.landing.announcementBtn_en = formData.get('announcementBtn_en') as string;
  db.landing.clientsTitle_en = formData.get('clientsTitle_en') as string;
  db.landing.clientsSubtitle_en = formData.get('clientsSubtitle_en') as string;
  db.landing.featuresTitle_en = formData.get('featuresTitle_en') as string;
  db.landing.featuresSubtitle_en = formData.get('featuresSubtitle_en') as string;
  db.landing.featuresNavsTitle_en = formData.get('featuresNavsTitle_en') as string;
  db.landing.testimonialsTitle_en = formData.get('testimonialsTitle_en') as string;
  db.landing.testimonialsSubtitle_en = formData.get('testimonialsSubtitle_en') as string;
  db.landing.pricingTitle_en = formData.get('pricingTitle_en') as string;
  db.landing.pricingSubtitle_en = formData.get('pricingSubtitle_en') as string;
  db.landing.pricingThirdOption_en = formData.get('pricingThirdOption_en') as string;
  db.landing.pricingBtnText_en = formData.get('pricingBtnText_en') as string;
  db.landing.faqTitle_en = formData.get('faqTitle_en') as string;
  db.landing.ctaTitle_en = formData.get('ctaTitle_en') as string;
  db.landing.ctaSubtitle_en = formData.get('ctaSubtitle_en') as string;

  saveDB(db);
  success = true;
}
---

<AdminLayout title="Títulos de Secciones">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Títulos de Secciones
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Configura los títulos, subtítulos y textos globales de todas las secciones de la página principal.
      </p>
    </div>
    {
      success && (
        <span class="flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          ¡Cambios Guardados!
        </span>
      )
    }
  </div>

  <form method="POST" class="space-y-6">
    <!-- Announcement & URL -->
    <div
      class="rounded-xl border border-neutral-200/80 bg-white p-5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60"
    >
      <div class="mb-4 border-b border-neutral-100 pb-2.5 dark:border-neutral-800">
        <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">
          Banner Superior de Anuncios
        </h2>
      </div>
      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div>
          <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
            >Texto Botón (ES)</label
          >
          <input
            type="text"
            name="announcementBtn_es"
            value={db.landing?.announcementBtn_es || ''}
            class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
          />
        </div>
        <div>
          <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
            >Texto Botón (EN)</label
          >
          <input
            type="text"
            name="announcementBtn_en"
            value={db.landing?.announcementBtn_en || ''}
            class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
          />
        </div>
        <div>
          <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
            >URL de Destino</label
          >
          <input
            type="url"
            name="announcementUrl"
            value={db.landing?.announcementUrl || ''}
            class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
          />
        </div>
      </div>
    </div>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
      <!-- ESPAÑOL -->
      <div class="space-y-4">
        <div class="flex items-center gap-2 border-b border-neutral-200 pb-2 dark:border-neutral-800">
          <span class="rounded-md bg-orange-500/10 px-2 py-0.5 text-xs font-semibold text-orange-600 dark:text-orange-400">ES</span>
          <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">Español</h2>
        </div>

        <!-- Clientes -->
        <div class="rounded-xl border border-neutral-200/80 bg-white p-4.5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60 space-y-3">
          <h3 class="text-xs font-semibold text-orange-600 dark:text-orange-400">Sección: Clientes / Partners</h3>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Título</label>
            <input type="text" name="clientsTitle_es" value={db.landing?.clientsTitle_es || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Subtítulo</label>
            <input type="text" name="clientsSubtitle_es" value={db.landing?.clientsSubtitle_es || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
        </div>

        <!-- Características -->
        <div class="rounded-xl border border-neutral-200/80 bg-white p-4.5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60 space-y-3">
          <h3 class="text-xs font-semibold text-orange-600 dark:text-orange-400">Sección: Características</h3>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Título General</label>
            <input type="text" name="featuresTitle_es" value={db.landing?.featuresTitle_es || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Subtítulo General</label>
            <textarea name="featuresSubtitle_es" rows="2" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">{db.landing?.featuresSubtitle_es || ''}</textarea>
          </div>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Título Interactivo (HTML permitido)</label>
            <input type="text" name="featuresNavsTitle_es" value={db.landing?.featuresNavsTitle_es || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
        </div>

        <!-- Testimonios & Precios -->
        <div class="rounded-xl border border-neutral-200/80 bg-white p-4.5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60 space-y-3">
          <h3 class="text-xs font-semibold text-orange-600 dark:text-orange-400">Sección: Testimonios y Precios</h3>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Título Testimonios</label>
            <input type="text" name="testimonialsTitle_es" value={db.landing?.testimonialsTitle_es || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Subtítulo Testimonios</label>
            <textarea name="testimonialsSubtitle_es" rows="2" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">{db.landing?.testimonialsSubtitle_es || ''}</textarea>
          </div>
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Título Precios</label>
              <input type="text" name="pricingTitle_es" value={db.landing?.pricingTitle_es || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
            </div>
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Botón Contactar</label>
              <input type="text" name="pricingBtnText_es" value={db.landing?.pricingBtnText_es || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
            </div>
          </div>
        </div>

        <!-- FAQ & CTA -->
        <div class="rounded-xl border border-neutral-200/80 bg-white p-4.5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60 space-y-3">
          <h3 class="text-xs font-semibold text-orange-600 dark:text-orange-400">Sección: FAQ y CTA</h3>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Título FAQ (HTML permitido)</label>
            <input type="text" name="faqTitle_es" value={db.landing?.faqTitle_es || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Título CTA</label>
              <input type="text" name="ctaTitle_es" value={db.landing?.ctaTitle_es || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
            </div>
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Subtítulo CTA</label>
              <input type="text" name="ctaSubtitle_es" value={db.landing?.ctaSubtitle_es || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
            </div>
          </div>
        </div>
      </div>

      <!-- ENGLISH -->
      <div class="space-y-4">
        <div class="flex items-center gap-2 border-b border-neutral-200 pb-2 dark:border-neutral-800">
          <span class="rounded-md bg-orange-500/10 px-2 py-0.5 text-xs font-semibold text-orange-600 dark:text-orange-400">EN</span>
          <h2 class="text-sm font-semibold text-neutral-900 dark:text-white">English</h2>
        </div>

        <!-- Clients -->
        <div class="rounded-xl border border-neutral-200/80 bg-white p-4.5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60 space-y-3">
          <h3 class="text-xs font-semibold text-orange-600 dark:text-orange-400">Section: Clients / Partners</h3>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Title</label>
            <input type="text" name="clientsTitle_en" value={db.landing?.clientsTitle_en || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Subtitle</label>
            <input type="text" name="clientsSubtitle_en" value={db.landing?.clientsSubtitle_en || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
        </div>

        <!-- Features -->
        <div class="rounded-xl border border-neutral-200/80 bg-white p-4.5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60 space-y-3">
          <h3 class="text-xs font-semibold text-orange-600 dark:text-orange-400">Section: Features</h3>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">General Title</label>
            <input type="text" name="featuresTitle_en" value={db.landing?.featuresTitle_en || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">General Subtitle</label>
            <textarea name="featuresSubtitle_en" rows="2" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">{db.landing?.featuresSubtitle_en || ''}</textarea>
          </div>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Interactive Title (HTML allowed)</label>
            <input type="text" name="featuresNavsTitle_en" value={db.landing?.featuresNavsTitle_en || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
        </div>

        <!-- Testimonials & Pricing -->
        <div class="rounded-xl border border-neutral-200/80 bg-white p-4.5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60 space-y-3">
          <h3 class="text-xs font-semibold text-orange-600 dark:text-orange-400">Section: Testimonials & Pricing</h3>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Title Testimonials</label>
            <input type="text" name="testimonialsTitle_en" value={db.landing?.testimonialsTitle_en || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Subtitle Testimonials</label>
            <textarea name="testimonialsSubtitle_en" rows="2" class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white">{db.landing?.testimonialsSubtitle_en || ''}</textarea>
          </div>
          <div class="grid grid-cols-2 gap-3 pt-2">
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Title Pricing</label>
              <input type="text" name="pricingTitle_en" value={db.landing?.pricingTitle_en || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
            </div>
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">Contact Button</label>
              <input type="text" name="pricingBtnText_en" value={db.landing?.pricingBtnText_en || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
            </div>
          </div>
        </div>

        <!-- FAQ & CTA -->
        <div class="rounded-xl border border-neutral-200/80 bg-white p-4.5 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60 space-y-3">
          <h3 class="text-xs font-semibold text-orange-600 dark:text-orange-400">Section: FAQ & CTA</h3>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">FAQ Title (HTML allowed)</label>
            <input type="text" name="faqTitle_en" value={db.landing?.faqTitle_en || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">CTA Title</label>
              <input type="text" name="ctaTitle_en" value={db.landing?.ctaTitle_en || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
            </div>
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400">CTA Subtitle</label>
              <input type="text" name="ctaSubtitle_en" value={db.landing?.ctaSubtitle_en || ''} class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-1.5 text-xs text-neutral-900 focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white" />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="flex justify-end pt-2">
      <button
        type="submit"
        class="rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-2.5 text-xs font-semibold text-white shadow-md shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
      >
        Guardar Cambios
      </button>
    </div>
  </form>
</AdminLayout>
