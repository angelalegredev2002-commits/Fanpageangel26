---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB, saveDB } from '../../../utils/db';

let db = getDB();
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();

  if (!db.legal) db.legal = {};

  db.legal.cookiesEnabled = formData.get('enable_banner') ? 'on' : 'off';
  db.legal.cookiesTitle_es = formData.get('title_es') as string;
  db.legal.cookiesText_es = formData.get('text_es') as string;
  db.legal.cookiesAccept_es = formData.get('accept_es') as string;
  db.legal.cookiesDecline_es = formData.get('decline_es') as string;

  db.legal.cookiesTitle_en = formData.get('title_en') as string;
  db.legal.cookiesText_en = formData.get('text_en') as string;
  db.legal.cookiesAccept_en = formData.get('accept_en') as string;
  db.legal.cookiesDecline_en = formData.get('decline_en') as string;

  saveDB(db);
  success = true;
}
---

<AdminLayout title="Banner de Cookies">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Banner de Cookies (GDPR/CCPA)
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Configura los textos de consentimiento de cookies en español e inglés.
      </p>
    </div>
    {
      success && (
        <span class="flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          ¡Cambios Guardados!
        </span>
      )
    }
  </div>

  <div
    class="rounded-xl border border-neutral-200/80 bg-white p-6 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60"
  >
    <form method="POST" class="space-y-6">
      <div class="flex items-center gap-3 border-b border-neutral-100 pb-4 dark:border-neutral-800">
        <input
          type="checkbox"
          id="enable_banner"
          name="enable_banner"
          checked={db.legal?.cookiesEnabled !== 'off'}
          class="h-4 w-4 rounded border-neutral-300 text-orange-600 accent-orange-500 focus:ring-orange-500"
        />
        <label for="enable_banner" class="text-xs font-semibold text-neutral-900 dark:text-white"
          >Habilitar Banner de Consentimiento de Cookies</label
        >
      </div>

      <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
        <!-- Español -->
        <div class="space-y-4 rounded-xl border border-neutral-200/90 bg-neutral-50/70 p-4.5 dark:border-neutral-800 dark:bg-neutral-800/40">
          <h3
            class="border-b border-neutral-200/60 pb-2 text-xs font-semibold text-orange-600 dark:border-neutral-700/60 dark:text-orange-400"
          >
            Español
          </h3>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
              >Título del Banner</label
            >
            <input
              type="text"
              name="title_es"
              value={db.legal?.cookiesTitle_es || ''}
              class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
            />
          </div>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
              >Mensaje del Banner</label
            >
            <textarea
              name="text_es"
              rows="3"
              class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              >{db.legal?.cookiesText_es || ''}</textarea
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
                >Botón Aceptar</label
              >
              <input
                type="text"
                name="accept_es"
                value={db.legal?.cookiesAccept_es || ''}
                class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
                >Botón Rechazar</label
              >
              <input
                type="text"
                name="decline_es"
                value={db.legal?.cookiesDecline_es || ''}
                class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              />
            </div>
          </div>
        </div>

        <!-- English -->
        <div class="space-y-4 rounded-xl border border-neutral-200/90 bg-neutral-50/70 p-4.5 dark:border-neutral-800 dark:bg-neutral-800/40">
          <h3
            class="border-b border-neutral-200/60 pb-2 text-xs font-semibold text-orange-600 dark:border-neutral-700/60 dark:text-orange-400"
          >
            English
          </h3>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
              >Banner Title</label
            >
            <input
              type="text"
              name="title_en"
              value={db.legal?.cookiesTitle_en || ''}
              class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
            />
          </div>
          <div>
            <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
              >Banner Message</label
            >
            <textarea
              name="text_en"
              rows="3"
              class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              >{db.legal?.cookiesText_en || ''}</textarea
            >
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
                >Accept Button</label
              >
              <input
                type="text"
                name="accept_en"
                value={db.legal?.cookiesAccept_en || ''}
                class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              />
            </div>
            <div>
              <label class="mb-1 block text-[11px] font-medium text-neutral-600 dark:text-neutral-400"
                >Decline Button</label
              >
              <input
                type="text"
                name="decline_en"
                value={db.legal?.cookiesDecline_en || ''}
                class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
              />
            </div>
          </div>
        </div>
      </div>

      <div class="flex justify-end border-t border-neutral-100 pt-4 dark:border-neutral-800">
        <button
          type="submit"
          class="rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-2.5 text-xs font-semibold text-white shadow-md shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
        >
          Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
