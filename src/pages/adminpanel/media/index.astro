---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';

// Read all real images from the project's src/images directory
const imageFiles = import.meta.glob(
  '/src/images/**/*.{jpeg,jpg,png,gif,avif,webp,svg}',
  { eager: true }
);

const allImages = Object.entries(imageFiles).map(
  ([path, file]: [string, any], index) => {
    const name = path.split('/').pop() || `Image ${index}`;
    const mockSize = name.length * 12 + ' KB';

    return {
      id: index,
      url: file.default?.src || file.default || path,
      name: name,
      size: mockSize,
    };
  }
);

// Pagination Logic
const itemsPerPage = 8;
const url = new URL(Astro.request.url);
const currentPage = Number(url.searchParams.get('page')) || 1;
const totalPages = Math.ceil(allImages.length / itemsPerPage) || 1;
const validPage = Math.max(1, Math.min(currentPage, totalPages));

const startIdx = (validPage - 1) * itemsPerPage;
const endIdx = startIdx + itemsPerPage;
const realImages = allImages.slice(startIdx, endIdx);
---

<AdminLayout title="Biblioteca de Medios">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Biblioteca de Medios
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Gestiona las fotografías, gráficos y activos visuales de la plataforma.
      </p>
    </div>
    <button
      type="button"
      class="flex items-center gap-1.5 rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-4 py-2 text-xs font-semibold text-white shadow-md shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"
        ></path>
      </svg>
      Subir Archivo
    </button>
  </div>

  <!-- Drag and Drop Area -->
  <div
    class="group mb-6 w-full cursor-pointer rounded-xl border-2 border-dashed border-neutral-300 bg-neutral-50/50 p-8 text-center transition-colors hover:border-orange-500 hover:bg-orange-50/30 dark:border-neutral-700 dark:bg-neutral-900/40 dark:hover:border-orange-500/50 dark:hover:bg-neutral-800/40"
  >
    <div
      class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-xl bg-white shadow-xs transition-transform group-hover:scale-105 dark:bg-neutral-800"
    >
      <svg
        class="h-6 w-6 text-neutral-400 transition-colors group-hover:text-orange-500 dark:text-neutral-500"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M12 4v16m8-8H4"
        ></path>
      </svg>
    </div>
    <h3 class="text-xs font-semibold text-neutral-800 dark:text-neutral-200">
      Arrastra y suelta imágenes aquí
    </h3>
    <p class="mt-0.5 text-[11px] text-neutral-500 dark:text-neutral-400">
      o haz clic para explorar en tu equipo (JPG, PNG, WEBP, SVG)
    </p>
  </div>

  <!-- Gallery Grid -->
  <div class="mb-6 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
    {
      realImages.map(img => (
        <div class="group overflow-hidden rounded-xl border border-neutral-200/80 bg-white shadow-xs transition-all hover:border-orange-500/50 dark:border-neutral-800 dark:bg-neutral-900/60">
          <div class="relative h-36 w-full overflow-hidden bg-neutral-100 dark:bg-neutral-800">
            <img
              src={img.url}
              alt={img.name}
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-105"
            />
            <div class="absolute inset-0 flex items-center justify-center gap-2 bg-black/40 opacity-0 backdrop-blur-xs transition-opacity group-hover:opacity-100">
              <button
                type="button"
                class="rounded-lg bg-white/90 p-2 text-neutral-800 transition-colors hover:bg-orange-500 hover:text-white dark:bg-neutral-800 dark:text-white dark:hover:bg-orange-500"
                title="Ver"
              >
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"
                  />
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"
                  />
                </svg>
              </button>
              <button
                type="button"
                class="rounded-lg bg-white/90 p-2 text-rose-600 transition-colors hover:bg-rose-500 hover:text-white dark:bg-neutral-800 dark:text-rose-400 dark:hover:bg-rose-500"
                title="Eliminar"
              >
                <svg
                  class="h-4 w-4"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                  />
                </svg>
              </button>
            </div>
          </div>
          <div class="p-3">
            <p class="truncate text-xs font-medium text-neutral-800 dark:text-neutral-200" title={img.name}>
              {img.name}
            </p>
            <p class="mt-0.5 text-[10px] text-neutral-400 dark:text-neutral-500">{img.size}</p>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Pagination Controls -->
  {
    totalPages > 1 && (
      <div class="flex items-center justify-between border-t border-neutral-100 pt-4 dark:border-neutral-800">
        <div class="text-xs text-neutral-500 dark:text-neutral-400">
          Mostrando página <span class="font-semibold text-neutral-900 dark:text-white">{validPage}</span>{' '}
          de <span class="font-semibold text-neutral-900 dark:text-white">{totalPages}</span>
        </div>
        <div class="flex items-center gap-2">
          <a
            href={validPage > 1 ? `?page=${validPage - 1}` : '#'}
            class={`rounded-lg px-3 py-1.5 text-xs font-medium transition-colors ${validPage > 1 ? 'border border-neutral-200 bg-white text-neutral-700 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200' : 'pointer-events-none cursor-not-allowed border border-neutral-100 bg-neutral-50 text-neutral-300 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-600'}`}
          >
            Anterior
          </a>
          <a
            href={validPage < totalPages ? `?page=${validPage + 1}` : '#'}
            class={`rounded-lg px-3 py-1.5 text-xs font-medium transition-colors ${validPage < totalPages ? 'border border-neutral-200 bg-white text-neutral-700 hover:bg-neutral-50 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-200' : 'pointer-events-none cursor-not-allowed border border-neutral-100 bg-neutral-50 text-neutral-300 dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-600'}`}
          >
            Siguiente
          </a>
        </div>
      </div>
    )
  }
</AdminLayout>
