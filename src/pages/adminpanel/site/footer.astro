---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB, saveDB } from '../../../utils/db';

let db = getDB();
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (!db.site) db.site = {};
  db.site.footerText_es = formData.get('footerText_es') as string;
  db.site.footerText_en = formData.get('footerText_en') as string;
  saveDB(db);
  success = true;
}
---

<AdminLayout title="Configuración del Footer">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Configuración del Footer
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Gestiona el texto de copyright y los enlaces del pie de página.
      </p>
    </div>
    {
      success && (
        <span class="flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          ¡Cambios Guardados!
        </span>
      )
    }
  </div>

  <div
    class="rounded-xl border border-neutral-200/80 bg-white p-6 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60"
  >
    <form method="POST" class="space-y-6">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <div>
          <label
            for="footerText_es"
            class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
            >Texto de Copyright (Español)</label
          >
          <input
            type="text"
            id="footerText_es"
            name="footerText_es"
            value={db.site?.footerText_es || ''}
            class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
          />
        </div>
        <div>
          <label
            for="footerText_en"
            class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
            >Texto de Copyright (English)</label
          >
          <input
            type="text"
            id="footerText_en"
            name="footerText_en"
            value={db.site?.footerText_en || ''}
            class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
          />
        </div>
      </div>

      <div>
        <label class="mb-1 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
          >Redes Sociales (Próximamente)</label
        >
        <p class="mb-3 text-[11px] text-neutral-500 dark:text-neutral-400">
          La gestión de redes sociales estará disponible en la siguiente actualización.
        </p>
        <div class="pointer-events-none opacity-50">
          <div class="flex gap-2">
            <span
              class="inline-flex items-center rounded-lg border border-neutral-200 bg-neutral-100 px-3 text-xs text-neutral-500 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-400"
              >Twitter / X</span
            >
            <input
              type="url"
              value="https://twitter.com/dedicatory"
              disabled
              class="flex-1 rounded-lg border border-neutral-200 bg-neutral-100 px-3 py-1.5 text-xs text-neutral-700 dark:border-neutral-700 dark:bg-neutral-800 dark:text-neutral-300"
            />
          </div>
        </div>
      </div>

      <div class="flex justify-end border-t border-neutral-100 pt-4 dark:border-neutral-800">
        <button
          type="submit"
          class="rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-2.5 text-xs font-semibold text-white shadow-md shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
        >
          Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
