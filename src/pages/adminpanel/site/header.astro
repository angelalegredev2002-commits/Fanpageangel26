---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';
import { getDB, saveDB } from '../../../utils/db';

let db = getDB();
let success = false;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  if (!db.site) db.site = {};
  db.site.brandText = formData.get('brandText') as string;
  db.site.stickyHeader = formData.get('stickyHeader') ? 'on' : 'off';
  saveDB(db);
  success = true;
}
---

<AdminLayout title="Configuración del Header">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Configuración del Header
      </h1>
      <p class="mt-0.5 text-xs text-neutral-500 dark:text-neutral-400">
        Gestiona el nombre de marca visible y el comportamiento de la cabecera en el sitio público.
      </p>
    </div>
    {
      success && (
        <span class="flex items-center gap-1.5 rounded-xl border border-emerald-500/30 bg-emerald-500/10 px-3.5 py-1.5 text-xs font-semibold text-emerald-600 dark:text-emerald-400">
          <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7" />
          </svg>
          ¡Cambios Guardados!
        </span>
      )
    }
  </div>

  <div
    class="rounded-xl border border-neutral-200/80 bg-white p-6 shadow-xs dark:border-neutral-800/80 dark:bg-neutral-900/60"
  >
    <form method="POST" class="space-y-5">
      <div>
        <label
          for="brandText"
          class="mb-1.5 block text-xs font-medium text-neutral-700 dark:text-neutral-300"
          >Texto del Logo / Marca</label
        >
        <input
          type="text"
          id="brandText"
          name="brandText"
          value={db.site?.brandText || ''}
          class="w-full rounded-lg border border-neutral-200 bg-white px-3 py-2 text-xs text-neutral-900 transition-colors focus:border-orange-500 focus:outline-none dark:border-neutral-700 dark:bg-neutral-900 dark:text-white"
        />
      </div>

      <div class="flex items-center gap-3 pt-1">
        <input
          type="checkbox"
          id="stickyHeader"
          name="stickyHeader"
          checked={db.site?.stickyHeader !== 'off'}
          class="h-4 w-4 rounded border-neutral-300 text-orange-600 accent-orange-500 focus:ring-orange-500"
        />
        <label for="stickyHeader" class="text-xs font-medium text-neutral-700 dark:text-neutral-300"
          >Habilitar cabecera fija (Sticky Header)</label
        >
      </div>

      <div class="flex justify-end border-t border-neutral-100 pt-4 dark:border-neutral-800">
        <button
          type="submit"
          class="rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-6 py-2.5 text-xs font-semibold text-white shadow-md shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
        >
          Guardar Cambios
        </button>
      </div>
    </form>
  </div>
</AdminLayout>
