---
export const prerender = false;
import AdminLayout from '@layouts/AdminLayout.astro';

const users = [
  { id: 1, name: 'Angel Alegre', email: 'angel@angelalegre.com', role: 'Admin', status: 'active', initials: 'AA', color: 'from-orange-400 to-orange-600', lastSeen: 'Ahora mismo' },
  { id: 2, name: 'Carlos Mendoza', email: 'carlos@cliente.com', role: 'Viewer', status: 'active', initials: 'CM', color: 'from-blue-400 to-blue-600', lastSeen: 'Hace 2 horas' },
  { id: 3, name: 'Laura González', email: 'laura@empresa.pe', role: 'Viewer', status: 'inactive', initials: 'LG', color: 'from-purple-400 to-purple-600', lastSeen: 'Hace 3 días' },
  { id: 4, name: 'Roberto Díaz', email: 'roberto@gmail.com', role: 'Viewer', status: 'pending', initials: 'RD', color: 'from-green-400 to-emerald-600', lastSeen: 'Nunca' },
];

const statusMap: Record<string, { label: string; class: string; dot: string }> = {
  active: { label: 'Activo', class: 'bg-green-500/10 text-green-500 dark:text-green-400', dot: 'bg-green-500' },
  inactive: { label: 'Inactivo', class: 'bg-neutral-500/10 text-neutral-500 dark:text-neutral-400', dot: 'bg-neutral-400' },
  pending: { label: 'Pendiente', class: 'bg-amber-500/10 text-amber-500 dark:text-amber-400', dot: 'bg-amber-400' },
};

const roleMap: Record<string, string> = {
  Admin: 'bg-orange-500/10 text-orange-500 dark:text-orange-400 border border-orange-500/20',
  Viewer: 'bg-neutral-100 text-neutral-600 dark:bg-neutral-800 dark:text-neutral-400',
};
---

<AdminLayout title="Usuarios">
  <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-2xl font-semibold tracking-tight text-neutral-900 dark:text-white">
        Gestión de <span class="bg-gradient-to-r from-orange-400 to-orange-600 bg-clip-text text-transparent">Usuarios</span>
      </h1>
      <p class="mt-1 text-neutral-500 dark:text-neutral-400">
        {users.length} usuarios registrados · {users.filter(u => u.status === 'active').length} activos
      </p>
    </div>
    <button
      class="flex items-center gap-2 rounded-xl bg-gradient-to-r from-orange-500 to-orange-600 px-5 py-2.5 text-sm font-bold text-white shadow-lg shadow-orange-500/25 transition-all hover:from-orange-400 hover:to-orange-500 hover:-translate-y-0.5"
    >
      <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
      </svg>
      Invitar Usuario
    </button>
  </div>

  <!-- Filters -->
  <div class="mb-5 flex flex-wrap items-center gap-3">
    <div class="flex items-center gap-2 rounded-xl border border-neutral-200 bg-white px-3 py-2 shadow-sm dark:border-neutral-800 dark:bg-neutral-900">
      <svg class="h-4 w-4 text-neutral-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input
        type="text"
        placeholder="Buscar usuario..."
        class="w-48 bg-transparent text-sm text-neutral-700 outline-none placeholder:text-neutral-400 dark:text-neutral-300"
      />
    </div>
    <select class="rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm font-medium text-neutral-700 shadow-sm outline-none dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300">
      <option>Todos los roles</option>
      <option>Admin</option>
      <option>Viewer</option>
    </select>
    <select class="rounded-xl border border-neutral-200 bg-white px-3 py-2 text-sm font-medium text-neutral-700 shadow-sm outline-none dark:border-neutral-800 dark:bg-neutral-900 dark:text-neutral-300">
      <option>Todos los estados</option>
      <option>Activo</option>
      <option>Inactivo</option>
      <option>Pendiente</option>
    </select>
  </div>

  <!-- Users Table -->
  <div class="overflow-hidden rounded-2xl border border-neutral-200 bg-white shadow-sm dark:border-neutral-800 dark:bg-neutral-900/70">
    <table class="w-full">
      <thead>
        <tr class="border-b border-neutral-200 dark:border-neutral-800">
          <th class="px-6 py-4 text-left text-xs font-bold tracking-wider text-neutral-500 uppercase dark:text-neutral-400">
            Usuario
          </th>
          <th class="hidden px-6 py-4 text-left text-xs font-bold tracking-wider text-neutral-500 uppercase sm:table-cell dark:text-neutral-400">
            Rol
          </th>
          <th class="hidden px-6 py-4 text-left text-xs font-bold tracking-wider text-neutral-500 uppercase md:table-cell dark:text-neutral-400">
            Estado
          </th>
          <th class="hidden px-6 py-4 text-left text-xs font-bold tracking-wider text-neutral-500 uppercase lg:table-cell dark:text-neutral-400">
            Último acceso
          </th>
          <th class="px-6 py-4 text-right text-xs font-bold tracking-wider text-neutral-500 uppercase dark:text-neutral-400">
            Acciones
          </th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100 dark:divide-neutral-800">
        {
          users.map((user) => {
            const status = statusMap[user.status];
            return (
              <tr class="group transition-colors hover:bg-neutral-50 dark:hover:bg-neutral-800/50">
                <!-- User info -->
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div
                      class={`flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-gradient-to-br ${user.color} text-sm font-bold text-white shadow-sm`}
                    >
                      {user.initials}
                    </div>
                    <div>
                      <p class="text-sm font-semibold text-neutral-900 dark:text-white">{user.name}</p>
                      <p class="text-xs text-neutral-500 dark:text-neutral-400">{user.email}</p>
                    </div>
                  </div>
                </td>
                <!-- Role -->
                <td class="hidden px-6 py-4 sm:table-cell">
                  <span class={`inline-flex items-center rounded-lg px-2.5 py-0.5 text-xs font-bold ${roleMap[user.role]}`}>
                    {user.role}
                  </span>
                </td>
                <!-- Status -->
                <td class="hidden px-6 py-4 md:table-cell">
                  <span class={`inline-flex items-center gap-1.5 rounded-lg px-2.5 py-0.5 text-xs font-bold ${status.class}`}>
                    <span class={`h-1.5 w-1.5 rounded-full ${status.dot}`} />
                    {status.label}
                  </span>
                </td>
                <!-- Last seen -->
                <td class="hidden px-6 py-4 text-sm text-neutral-500 lg:table-cell dark:text-neutral-400">
                  {user.lastSeen}
                </td>
                <!-- Actions -->
                <td class="px-6 py-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    <button
                      class="rounded-lg px-3 py-1.5 text-xs font-medium text-neutral-600 transition-colors hover:bg-neutral-100 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-neutral-800 dark:hover:text-white"
                    >
                      Editar
                    </button>
                    {user.role !== 'Admin' && (
                      <button
                        class="rounded-lg px-3 py-1.5 text-xs font-medium text-red-500 transition-colors hover:bg-red-50 hover:text-red-600 dark:text-red-400 dark:hover:bg-red-500/10"
                      >
                        Eliminar
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            );
          })
        }
      </tbody>
    </table>
  </div>

  <!-- Note -->
  <p class="mt-4 text-center text-xs text-neutral-400 dark:text-neutral-600">
    Los datos de usuarios son de demostración. Conecta un proveedor de autenticación para gestión real.
  </p>
</AdminLayout>
